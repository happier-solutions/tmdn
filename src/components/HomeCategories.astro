---
import { CATEGORIES } from '../data/taxonomy';
import type { Post } from '../lib/posts';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

// One tip per category, on a circle of radius 100, in the order one line draws the star: each tip is two along from the last.
const TIPS = [
	[0, -100],
	[58.8, 80.9],
	[-95.1, -30.9],
	[95.1, -30.9],
	[-58.8, 80.9],
];
// Five chords, one per stage, each from its tip to the next stage's. The line turns 144deg at every tip.
const CHORD = 190.2;
const chordAngle = (index: number) => 72 + 144 * index;

const sideOf = (x: number) => (x === 0 ? 'top' : x > 0 ? 'right' : 'left');
const countOf = (slug: string) => posts.filter((post) => post.data.category === slug).length;
---

<div class="ruled categories">
	<div class="cell star" aria-hidden="true">
		<svg viewBox="-110 -114 220 209">
			{TIPS.map(([x, y], index) => (
				<g transform={`translate(${x} ${y}) rotate(${chordAngle(index)})`}>
					<line class="chord" x2={CHORD} style={`--i: ${index}`} />
				</g>
			))}
			<g class="numbers">
				{TIPS.map(([x, y], index) => (
					<g transform={`translate(${x} ${y})`}>
						<g class="number" style={`--i: ${index}`}>
							<circle r="13" />
							<text>{index + 1}</text>
						</g>
					</g>
				))}
			</g>
		</svg>
	</div>
	{CATEGORIES.map(({ slug, label, description }, index) => {
		const [x, y] = TIPS[index];
		const count = countOf(slug);
		return (
			<div class:list={['cell linked tip', sideOf(x)]} style={`--x: ${x / 100}; --y: ${y / 100}; --i: ${index}`}>
				<CategoryIcon {slug} />
				<div class="copy">
					<h3><a href={`/${slug}/`}>{label}</a></h3>
					<p>{description}</p>
					<p class="count">Chặng {index + 1} · {count ? `${count} bài` : 'Chưa có bài'}</p>
				</div>
			</div>
		);
	})}
</div>

<script>
	// Waits until the star is on screen. Without this script it just draws on load, out of sight.
	const categories = document.querySelector<HTMLElement>('.categories');
	const star = categories?.querySelector('.star');
	if (categories && star) {
		categories.dataset.wait = '';
		const observer = new IntersectionObserver(
			([entry]) => {
				if (!entry.isIntersecting) return;
				observer.disconnect();
				delete categories.dataset.wait;
			},
			{ threshold: 0.5 },
		);
		observer.observe(star);
	}
</script>

<style>
	.categories {
		/* The home page's focal point. Always dark, so tokens resolve to their dark values here, as in the footer. */
		color-scheme: dark;
		display: flex;
		flex-wrap: wrap;
		background: var(--paper);
	}
	h3 {
		margin: 0;
		font-size: 1.25rem;
	}
	p {
		margin: 0;
	}
	line,
	circle {
		fill: var(--paper);
		stroke: var(--gold);
		stroke-width: 1px;
		vector-effect: non-scaling-stroke;
	}
	text {
		fill: var(--accent);
		font-size: 14px;
		text-anchor: middle;
		dominant-baseline: central;
	}

	/* Too narrow for text beside the star: a small star above, numbered to match the cells. */
	.cell {
		--px: 1.5rem;
		flex: 1 1 10rem;
	}
	.star {
		flex-basis: 100%;
	}
	.star svg {
		display: block;
		width: min(14rem, 100%);
		margin-inline: auto;
	}
	.copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.5rem;
	}

	/* Each icon sits on its tip, with the text outward from the star. Tips are at --x and --y radii from the center. */
	@media (min-width: 64rem) {
		.categories {
			--r: 12rem;
			--center: 25rem;
			--disc-half: 1.6875rem;
			position: relative;
			display: block;
			height: 41rem;
		}
		.star,
		.tip {
			position: absolute;
			margin: 0;
			padding: 0;
			border: 0;
		}
		/* The viewBox starts 114 above the center and is 220 wide, on a radius of 100. */
		.star {
			top: calc(var(--center) - 1.14 * var(--r));
			left: 50%;
			width: calc(2.2 * var(--r));
			translate: -50% 0;
		}
		.star svg {
			width: 100%;
		}
		.numbers {
			display: none;
		}
		.tip {
			top: calc(var(--center) + var(--y) * var(--r));
			flex-direction: row;
			gap: 1rem;
			align-items: center;
			translate: 0 -50%;
		}
		.tip > :global(svg) {
			box-sizing: content-box;
			width: 2.25rem;
			height: 2.25rem;
			padding: 0.5rem;
			border: 1px solid var(--gold);
			border-radius: 50%;
			background: var(--paper);
		}
		.copy {
			flex: 0 1 18rem;
		}
		.right {
			right: 2rem;
			left: calc(50% + var(--x) * var(--r) - var(--disc-half));
		}
		.left {
			right: calc(50% - var(--x) * var(--r) - var(--disc-half));
			left: 2rem;
			flex-direction: row-reverse;
			text-align: end;
		}
		.top {
			top: calc(var(--center) - var(--r) + var(--disc-half));
			left: 50%;
			width: 26rem;
			flex-direction: column-reverse;
			text-align: center;
			translate: -50% -100%;
		}
		.top .copy {
			flex: none;
		}
		.tip .count {
			padding-top: 0.25rem;
		}
		/* A filled rectangle would cover the star's lines, so the disc takes the hover. */
		.categories .tip:has(a:hover) {
			background: none;
		}
		.tip:has(a:hover) > :global(svg) {
			background: var(--gray-light);
		}
		.categories .tip:has(a:focus-visible) {
			outline-offset: 0.5rem;
		}
	}

	/* One line, stage by stage: a chord arrives, the stage's marker appears, the next chord leaves. Screen only, so a paused animation can't print as a blank star. */
	@media screen and (prefers-reduced-motion: no-preference) {
		.chord {
			animation: categories-chord 500ms cubic-bezier(0.4, 0, 0.4, 1) calc(100ms + var(--i) * 600ms) backwards;
		}
		.number {
			animation: categories-marker 400ms cubic-bezier(0.2, 0.7, 0.3, 1) calc(var(--i) * 600ms) backwards;
		}
		.categories[data-wait] :is(.chord, .number) {
			animation-play-state: paused;
		}
	}
	@media screen and (prefers-reduced-motion: no-preference) and (min-width: 64rem) {
		.tip > :global(svg) {
			animation: categories-marker 400ms cubic-bezier(0.2, 0.7, 0.3, 1) calc(var(--i) * 600ms) backwards;
		}
		.categories[data-wait] .tip > :global(svg) {
			animation-play-state: paused;
		}
	}

	/* Scales along the line instead of using a dash offset, which breaks with a non-scaling stroke. */
	@keyframes categories-chord {
		from {
			scale: 0 1;
		}
	}
	@keyframes categories-marker {
		from {
			opacity: 0;
			scale: 0.6;
		}
	}
</style>
