<button class="time-on-page" type="button" data-still popovertarget="time-on-page-bubble" aria-label="Xem thời gian bạn đã ở trên trang">
	<svg class="glass" viewBox="4 2 16 20" width="26" height="26" aria-hidden="true">
		<clipPath id="hourglass-top"><path d="M6 4h12l-6 8z"></path></clipPath>
		<clipPath id="hourglass-bottom"><path d="M6 20h12l-6-8z"></path></clipPath>
		<g clip-path="url(#hourglass-top)"><rect class="sand-left" x="5" y="4.5" width="14" height="7.5"></rect></g>
		<g clip-path="url(#hourglass-bottom)"><rect class="sand-fallen" x="5" y="14.8" width="14" height="7.5"></rect></g>
		<path class="stream" d="M12 12v8"></path>
		<path class="frame" d="M6 4h12L6 20h12z"></path>
	</svg>
</button>
<div id="time-on-page-bubble" class="bubble" popover>Bạn đã ở đây <span class="time">0 giây</span></div>
<script>
	import { formatDuration, trackForegroundTime } from '../lib/foreground-time';

	const PERIOD = 15;

	const button = document.querySelector<HTMLElement>('.time-on-page');
	const glass = button?.querySelector('.glass');
	const fallen = button?.querySelector('.sand-fallen');
	const bubble = document.querySelector<HTMLElement>('.bubble');
	const time = bubble?.querySelector('.time');
	if (button && glass && fallen && bubble && time) {
		const foregroundTime = trackForegroundTime();
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
		let shown = 0;
		let flipping = false;

		// A jump, as the sand otherwise eases from one second to the next.
		const setTurn = (turn: number) => {
			button.style.setProperty('--turn', String(turn));
			if (flipping) return;
			button.getBoundingClientRect();
			button.toggleAttribute('data-still', false);
		};

		// Upside down, the fallen sand slid to the neck is where the full top bulb starts, so the swap at the end doesn't show.
		const flip = () => {
			flipping = true;
			button.toggleAttribute('data-still', true);
			setTurn(1);
			const timing = { duration: 900, easing: 'cubic-bezier(0.65, 0, 0.35, 1)' };
			// The sand only slides once the glass is past horizontal.
			fallen.animate(
				{ transform: ['translateY(0)', 'translateY(0)', 'translateY(-2.8px)'], offset: [0, 0.5, 1] },
				timing,
			);
			glass.animate({ transform: ['rotate(0deg)', 'rotate(180deg)'] }, timing).onfinish = () => {
				flipping = false;
				tick();
			};
		};

		const tick = () => {
			if (document.hidden) return;
			const ms = foregroundTime();
			const seconds = ms / 1000;
			time.textContent = formatDuration(ms);
			if (reducedMotion.matches) return;
			const periods = Math.floor(seconds / PERIOD);
			if (periods !== shown) {
				shown = periods;
				flip();
			}
			if (!flipping) setTurn((seconds % PERIOD) / PERIOD);
		};
		tick();
		setInterval(tick, 1000);

		// A click on a bubble opened by hovering pins it, instead of closing it under the pointer.
		let openedByHover = false;
		let closing = 0;
		const enter = (event: PointerEvent) => {
			if (event.pointerType !== 'mouse') return;
			clearTimeout(closing);
			if (bubble.matches(':popover-open')) return;
			bubble.togglePopover(true);
			openedByHover = true;
		};
		const leave = (event: PointerEvent) => {
			if (event.pointerType !== 'mouse' || !openedByHover) return;
			// Long enough to cross the gap, as the pointer may move on to the bubble to read it.
			closing = setTimeout(() => bubble.togglePopover(false), 200);
		};
		button.addEventListener('pointerenter', enter);
		bubble.addEventListener('pointerenter', enter);
		button.addEventListener('pointerleave', leave);
		bubble.addEventListener('pointerleave', leave);
		button.addEventListener('click', (event) => {
			if (!openedByHover) return;
			event.preventDefault();
			clearTimeout(closing);
			openedByHover = false;
		});
		bubble.addEventListener('toggle', (event) => {
			if ((event as ToggleEvent).newState === 'closed') openedByHover = false;
		});
	}
</script>
<style>
	.time-on-page {
		display: grid;
		place-items: center;
		box-sizing: border-box;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid var(--gold);
		border-radius: 50%;
		background: none;
		color: var(--gray-dark);
		cursor: pointer;
	}
	@media (hover: hover) {
		.time-on-page:hover {
			border-color: var(--accent);
			color: var(--accent);
		}
	}
	.time-on-page:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	/* Same weight as the 18px ShareLinks icons beside it, whatever the size. */
	.frame {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5px;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}
	.sand-left,
	.sand-fallen {
		fill: var(--gold);
	}
	/* Half drained until the script sets --turn, and for good under reduced motion. */
	.sand-left {
		transform: translateY(calc(var(--turn, 0.5) * 7.5px));
		transition: transform 1s linear;
	}
	.sand-fallen {
		transform: translateY(calc((1 - var(--turn, 0.5)) * 5.2px));
		transition: transform 1s linear;
	}
	[data-still] .sand-left,
	[data-still] .sand-fallen {
		transition: none;
	}
	/* Grains falling through the neck, in the viewBox's units so the dashes keep their spacing. */
	.stream {
		display: none;
		stroke: var(--gold);
		stroke-width: 1;
		stroke-dasharray: 1 1.5;
	}
	@media (prefers-reduced-motion: no-preference) {
		.stream {
			display: block;
			animation: fall 500ms linear infinite;
		}
		[data-still] .stream {
			display: none;
		}
	}
	@keyframes fall {
		to {
			stroke-dashoffset: -2.5;
		}
	}
	/* Without anchor positioning the bubble sits where the ShareLinks toast does, with no tail. */
	.bubble {
		--rise: 0.5rem;
		position: fixed;
		inset: auto 0 1.5rem;
		width: fit-content;
		max-width: calc(100vw - 2rem);
		margin: 0 auto;
		padding: 0.5rem 1rem;
		overflow: visible;
		border: 0;
		border-radius: 1.25rem;
		background: var(--black);
		color: var(--paper);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		line-height: 1.5;
		opacity: 0;
		transform: translateY(var(--rise));
		transition:
			opacity 220ms ease-out,
			transform 220ms ease-out,
			display 220ms allow-discrete,
			overlay 220ms allow-discrete;
	}
	.bubble:popover-open {
		opacity: 1;
		transform: none;
	}
	@starting-style {
		.bubble:popover-open {
			opacity: 0;
			transform: translateY(var(--rise));
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.bubble {
			--rise: 0;
		}
	}
	@supports (anchor-name: --time-on-page) {
		.time-on-page {
			anchor-name: --time-on-page;
		}
		.bubble {
			position-anchor: --time-on-page;
			position-area: block-start span-inline-start;
			inset: auto;
			margin: 0 0 0.75rem;
		}
		/* Points at the middle of the button. */
		.bubble::after {
			content: '';
			position: absolute;
			right: 1rem;
			bottom: -0.45rem;
			width: 0.75rem;
			height: 0.5rem;
			background: inherit;
			clip-path: polygon(0 0, 100% 0, 50% 100%);
		}
	}
	/* The rail beside the post, from the same width as the grid in PostLayout. */
	@media (min-width: 64rem) {
		.time-on-page {
			width: 2.25rem;
			height: 2.25rem;
		}
		@supports (anchor-name: --time-on-page) {
			.bubble {
				position-area: inline-end;
				margin: 0 0 0 0.75rem;
			}
			.bubble::after {
				top: calc(50% - 0.375rem);
				right: auto;
				bottom: auto;
				left: -0.45rem;
				width: 0.5rem;
				height: 0.75rem;
				clip-path: polygon(100% 0, 100% 100%, 0 50%);
			}
		}
	}
	@media (scripting: none), print {
		.time-on-page {
			display: none;
		}
	}
</style>
