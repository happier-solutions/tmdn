---
// A hairline at the top of the screen that fills as the post's body is read.
// Place it inside the element that holds `.post-body`, which sets the timeline scope.
---

<div class="reading-progress" aria-hidden="true"></div>
<script>
	// Browsers without scroll-driven animations (Firefox) get the same bar from a scroll listener.
	if (!CSS.supports('animation-timeline: view()')) {
		const bar = document.querySelector<HTMLElement>('.reading-progress');
		const body = document.querySelector<HTMLElement>('.post-body');
		if (bar && body) {
			let frame = 0;
			const update = () => {
				const { top, height } = body.getBoundingClientRect();
				const range = Math.max(1, height - innerHeight);
				bar.style.scale = `${Math.min(1, Math.max(0, -top / range))} 1`;
			};
			addEventListener(
				'scroll',
				() => {
					cancelAnimationFrame(frame);
					frame = requestAnimationFrame(update);
				},
				{ passive: true },
			);
			update();
		}
	}
</script>
<style>
	:global(:has(> .reading-progress)) {
		timeline-scope: --post-body;
	}
	:global(.post-body) {
		view-timeline: --post-body block;
	}
	.reading-progress {
		position: fixed;
		inset: 0 0 auto;
		z-index: 2;
		height: 3px;
		background: var(--bamboo);
		transform-origin: 0 50%;
		scale: 0 1;
	}
	/* From the body's top at the screen's top to its end at the screen's foot. */
	@supports (animation-timeline: view()) {
		.reading-progress {
			animation: reading-progress linear both;
			animation-timeline: --post-body;
			animation-range: contain 0% contain 100%;
		}
	}
	@keyframes reading-progress {
		to {
			scale: 1 1;
		}
	}
	@media print {
		.reading-progress {
			display: none;
		}
	}
</style>
