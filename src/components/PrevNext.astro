---
import type { Post } from '../lib/posts';
import PostTile from './PostTile.astro';

interface Props {
	newer?: Post;
	older?: Post;
}

const { newer, older } = Astro.props;
---

{(newer || older) && (
	<nav aria-labelledby="prev-next-heading">
		<h2 id="prev-next-heading" class="sr-only">Bài trước và bài sau</h2>
		{older ? (
			<div class="cell"><PostTile post={older} label="← Bài trước" rel="prev" alignDate /></div>
		) : (
			<p class="cell note">Đây là bài đầu tiên.</p>
		)}
		{newer ? (
			<div class="cell"><PostTile post={newer} label="Bài sau →" rel="next" alignDate /></div>
		) : (
			<p class="cell note">Đây là bài mới nhất.</p>
		)}
	</nav>
)}
<style>
	nav {
		display: grid;
		gap: 1.5rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	/* The end of the list has nowhere to go, so a phone's single column drops the note. */
	.note {
		display: none;
		margin: 0;
		color: var(--text-2);
		font-size: 1rem;
	}
	@media (min-width: 40rem) {
		nav {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 3rem;
		}
		.note {
			display: block;
		}
	}
</style>
