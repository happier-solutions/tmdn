---
import { Image } from 'astro:assets';
import { type Post, postUrl } from '../lib/posts';
import CategoryIcon from './CategoryIcon.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
	/** A short line above the title. */
	label?: string;
	rel?: 'prev' | 'next';
	/** Pins the date to the tile's foot, so dates line up across a row of tiles. */
	alignDate?: boolean;
}

const { post, label, rel, alignDate = false } = Astro.props;
const { title, pubDate, category, heroImage } = post.data;
---

<article class:list={{ 'align-date': alignDate }}>
	<div class="thumb">
		{heroImage ? (
			<Image src={heroImage} alt="" sizes="6rem" widths={[192, 288]} loading="lazy" />
		) : (
			<CategoryIcon slug={category} />
		)}
	</div>
	<div class="text">
		{label && <p class="label">{label}</p>}
		<h3><a href={postUrl(post)} {rel}>{title}</a></h3>
		<p class="date"><FormattedDate date={pubDate} /></p>
	</div>
</article>
<style>
	article {
		position: relative;
		display: grid;
		grid-template-columns: 6rem minmax(0, 1fr);
		gap: 1rem;
		height: 100%;
	}

	/* `width` and `align-self` let a taller text column stretch the frame past its ratio. */
	.thumb {
		position: relative;
		display: grid;
		place-items: center;
		align-self: stretch;
		width: 100%;
		aspect-ratio: 1;
		overflow: clip;
		border-radius: 8px;
		background: var(--gray-light);
	}
	.thumb img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}

	.text {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: 0.25rem;
		min-width: 0;
	}
	.text p {
		margin: 0;
		color: var(--gray);
		font-size: 0.875rem;
	}
	h3 {
		margin: 0;
		font-size: 1.125rem;
	}
	h3 a {
		color: inherit;
	}
	/* The title's link covers the card, and it keeps the link's hover rule and sprig. */
	h3 a::before {
		content: '';
		position: absolute;
		inset: 0;
	}
	.text .date {
		padding-top: 0.25rem;
	}
	.align-date .date {
		margin-top: auto;
	}

	h3 a:focus-visible {
		outline: none;
	}
	article:has(h3 a:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	/* The painting drifts closer inside its frame, slower than the link's own hover. */
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.thumb img {
			transition: scale 500ms ease-out;
		}
		article:has(h3 a:hover) img {
			scale: 1.04;
		}
	}
</style>
