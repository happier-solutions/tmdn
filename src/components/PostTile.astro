---
import { type Post, postUrl } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
import Thumb from './Thumb.astro';

interface Props {
	post: Post;
	/** A short line above the title. */
	label?: string;
	rel?: 'prev' | 'next';
	/** Pins the date to the tile's foot, so dates line up across a row of tiles. */
	alignDate?: boolean;
}

const { post, label, rel, alignDate = false } = Astro.props;
const { title, pubDate } = post.data;
---

<article class:list={{ 'align-date': alignDate }}>
	<Thumb {post} class="tile-thumb" sizes="6rem" widths={[192, 288]} />
	<div class="text">
		{label && <p class="label">{label}</p>}
		<h3 class="title"><a href={postUrl(post)} {rel}>{title}</a></h3>
		<p class="date"><FormattedDate date={pubDate} /></p>
	</div>
</article>
<style>
	article {
		position: relative;
		display: grid;
		grid-template-columns: 6rem minmax(0, 1fr);
		gap: 1rem;
		height: 100%;
	}

	/* `align-self` lets a taller text column stretch the frame past its ratio. */
	article :global(.tile-thumb) {
		align-self: stretch;
		aspect-ratio: 1;
	}

	.text {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: 0.25rem;
		min-width: 0;
	}
	.text p {
		margin: 0;
		color: var(--text-2);
		font-size: 0.875rem;
	}
	h3 {
		margin: 0;
		font-size: 1.125rem;
	}
	h3 a {
		color: inherit;
	}
	/* The title's link covers the card, and it keeps the link's hover rule and sprig. */
	h3 a::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}
	.text .date {
		padding-top: 0.25rem;
	}
	.align-date .date {
		margin-top: auto;
	}

	h3 a:focus-visible {
		outline: none;
	}
	article:has(h3 a:focus-visible) {
		outline: 2px solid var(--bamboo);
		outline-offset: 2px;
	}
</style>
