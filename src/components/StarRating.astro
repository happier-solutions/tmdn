---
interface Props {
	small?: boolean;
}

const { small = false } = Astro.props;
const stars = [1, 2, 3, 4, 5];
---

<div class:list={['stars', { small }]}>
	{stars.map((value) => (
		<label class="star">
			<input class="sr-only" type="radio" name="rating" value={value} required />
			<span class="sr-only">{value} sao</span>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M12 3.5l2.63 5.33 5.88.85-4.25 4.15 1 5.86L12 16.92l-5.26 2.77 1-5.86-4.25-4.15 5.88-.85z" />
			</svg>
		</label>
	))}
</div>

<style>
	.stars {
		--star: 2rem;
		--tap: 3rem;
		display: flex;
		/* Lines the outer stars up with the surrounding text, inside their tap targets. */
		margin-inline: calc((var(--star) - var(--tap)) / 2);
	}
	.small {
		--star: 1.25rem;
		--tap: 2.25rem;
	}
	.star {
		position: relative;
		display: grid;
		place-items: center;
		width: var(--tap);
		height: 3rem;
		cursor: pointer;
	}
	.star:has(input:focus-visible) {
		outline: 2px solid var(--bamboo);
		outline-offset: -2px;
	}
	svg {
		width: var(--star);
		height: var(--star);
		fill: none;
		stroke: var(--bamboo);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}
	/* The stars up to the chosen one fill in. */
	.star:has(input:checked) svg,
	.star:has(~ .star input:checked) svg {
		fill: var(--bamboo);
	}
	@media (hover: hover) {
		.star:hover svg,
		.star:has(~ .star:hover) svg {
			fill: var(--bamboo);
		}
		.star:hover ~ .star svg {
			fill: none;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		svg {
			transition: fill 150ms ease-out, scale 150ms ease-out;
		}
		@media (hover: hover) {
			.star:hover svg {
				scale: 1.1;
			}
		}
	}
</style>
