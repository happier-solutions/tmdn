---
import { SITE_TITLE } from '../consts';
import { CATEGORIES } from '../data/taxonomy';

const navItems = [
	...CATEGORIES.map(({ slug, label }) => ({ slug, label })),
	{ slug: 'gioi-thieu', label: 'Giới thiệu' },
];

const { pathname } = Astro.url;
const section = pathname.split('/')[1];

// 'page' on the section's own page, 'true' on anything inside it (a post, page 2).
const ariaCurrent = (slug: string) => {
	if (section !== slug) return undefined;
	return pathname.replace(/\/$/, '') === `/${slug}` ? 'page' : 'true';
};
---

<header class="site-header">
	<div class="wrap wrap-wide bar">
		<a class="brand" href="/">
			<img src="/favicon.svg" width="40" height="40" alt="" />
			<span>{SITE_TITLE}</span>
		</a>
		<button class="menu-button" type="button" popovertarget="site-nav">Menu</button>
		<nav id="site-nav" class="site-nav" popover aria-label="Menu chính">
			<button class="menu-button" type="button" popovertarget="site-nav" popovertargetaction="hide">
				Đóng
			</button>
			<ul>
				{navItems.map(({ slug, label }) => (
					<li><a href={`/${slug}/`} aria-current={ariaCurrent(slug)}>{label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</header>
<style>
	.site-header {
		border-bottom: 1px solid var(--gold);
		background: var(--paper);
	}
	/* Pinned while reading, except where it would take too much height:
	   landscape phones and the wrapped-row fallback without popover support. */
	@media (min-height: 34rem) {
		@supports selector(:popover-open) {
			.site-header {
				position: sticky;
				top: 0;
				z-index: 1;
			}
		}
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1.5rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		padding-block: 0.75rem;
		color: rgb(var(--black));
		font-family: var(--font-heading);
		font-size: 1.25rem;
		text-decoration: none;
	}
	.brand img {
		display: block;
		border-radius: 0;
	}
	.site-nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
		margin: 0;
		padding: 0 0 0.75rem;
		list-style: none;
	}
	.site-nav a {
		display: block;
		padding-block: 0.5rem;
		color: rgb(var(--gray-dark));
		font-size: 1rem;
		text-decoration: none;
	}
	.site-nav a:hover,
	.site-nav a[aria-current] {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}
	/* Without popover support the links stay visible as a wrapped row. */
	.menu-button {
		display: none;
		min-height: 2.75rem;
		padding-inline: 0.75rem;
		border: 1px solid var(--gold);
		background: none;
		color: rgb(var(--black));
		font: inherit;
		font-size: 1rem;
		cursor: pointer;
	}
	@media (max-width: 59.99rem) {
		@supports selector(:popover-open) {
			.menu-button {
				display: block;
			}
			.site-nav {
				inset: 0 0 0 auto;
				box-sizing: border-box;
				width: min(20rem, 85vw);
				height: 100dvh;
				margin: 0;
				padding: 1rem;
				border: 0;
				border-left: 1px solid var(--gold);
				background: var(--paper);
				color: inherit;
			}
			.site-nav::backdrop {
				background: rgba(var(--black), 0.4);
			}
			.site-nav ul {
				flex-direction: column;
				margin-top: 1rem;
			}
			.site-nav a {
				padding-block: 0.75rem;
			}
		}
	}
	/* Popover is only a small-screen behaviour: on wide screens the nav is a normal row. */
	@media (min-width: 60rem) {
		.site-nav {
			display: block;
			position: static;
			inset: auto;
			width: auto;
			height: auto;
			margin: 0;
			padding: 0;
			overflow: visible;
			border: 0;
			background: none;
			color: inherit;
		}
		.site-nav ul {
			padding-bottom: 0;
		}
	}
</style>
