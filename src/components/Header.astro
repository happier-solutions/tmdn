---
import { AUTHOR, SITE_NAME } from '../consts';
import { PILLARS } from '../data/taxonomy';
import ThemeSwitch from './ThemeSwitch.astro';

// Topics stay off the bar: each pillar's page lists its own.
const navItems = [
	{ href: '/', label: 'Trang chủ' },
	...PILLARS.map(({ slug, label }) => ({ href: `/${slug}/`, label })),
	{ href: '/gioi-thieu/', label: 'Giới thiệu' },
];

const { pathname } = Astro.url;

// 'page' on the section's own page, 'true' on anything inside it (a post, a topic).
const ariaCurrent = (href: string) => {
	if (pathname === href) return 'page';
	if (href !== '/' && pathname.startsWith(href)) return 'true';
	return undefined;
};
---


<header class="site-header">
	<div class="wrap wrap-wide bar">
		<a class="brand" href="/" aria-label={`${AUTHOR}, ${SITE_NAME}: trang chủ`}>
			<span class="seal" aria-hidden="true"></span>
			<span class="wordmark" aria-hidden="true">
				<span class="name">{AUTHOR}</span>
				<span class="site">{SITE_NAME}</span>
			</span>
		</a>
		<button class="menu-button" type="button" popovertarget="site-nav" aria-label="Mở menu">
			<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
				<path d="M4 6h16 M4 12h16 M4 18h16" />
			</svg>
		</button>
		<nav id="site-nav" class="site-nav" popover aria-label="Menu chính">
			<button class="menu-button" type="button" popovertarget="site-nav" popovertargetaction="hide" aria-label="Đóng menu">
				<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
					<path d="M6 6l12 12 M18 6L6 18" />
				</svg>
			</button>
			<ul>
				{navItems.map(({ href, label }) => (
					<li><a {href} aria-current={ariaCurrent(href)}><span class="link-line">{label}</span></a></li>
				))}
			</ul>
			<ThemeSwitch />
		</nav>
	</div>
</header>
<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}
	/* Pinned on desktop while reading, except on short windows where it would take too much height. */
	@media (min-width: 60rem) and (min-height: 34rem) {
		.site-header {
			position: sticky;
			top: 0;
			z-index: 1;
		}
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1.5rem;
	}
	/* A wordmark, not a link with a rule: the hover only shifts its color. */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding-block: 0.75rem;
		color: var(--text);
		background: none;
	}
	.brand::after {
		display: none;
	}
	.brand:hover {
		color: var(--bamboo);
	}
	/* A small seal: the logo's sprig cut out of seal red. */
	.seal {
		flex: none;
		width: 2rem;
		height: 2rem;
		background: var(--seal);
		mask:
			url('/sprig.svg') center / 1.375rem no-repeat exclude,
			linear-gradient(#000 0 0);
	}
	.wordmark {
		display: grid;
		line-height: 1.15;
	}
	.name {
		font-family: var(--font-heading);
		font-size: 1.1875rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.site {
		color: var(--text-2);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.site-nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5rem;
		margin: 0;
		padding: 0 0 0.75rem;
		list-style: none;
	}
	.site-nav a {
		display: block;
		padding-block: 0.5rem;
		color: var(--text);
		font-size: 0.875rem;
	}
	/* The current page is set apart by color alone; the rule and sprig stay hover details. */
	.site-nav a[aria-current] {
		color: var(--bamboo);
	}
	/* Forced colors drop the link color, so the state needs another mark there. */
	@media (forced-colors: active) {
		.site-nav a[aria-current] .link-line {
			text-decoration: underline;
		}
	}
	/* Without popover support the links stay visible as a wrapped row. */
	.menu-button {
		display: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		/* Pulled out by the empty space around the icon, so the icon lines up with the page edge. */
		margin-inline-end: -0.625rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--text);
		cursor: pointer;
	}
	@media (hover: hover) {
		.menu-button:hover {
			color: var(--bamboo);
		}
	}
	.menu-button:focus-visible {
		outline: 2px solid var(--bamboo);
		outline-offset: 2px;
	}
	.menu-button svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	@media (max-width: 59.99rem) {
		@supports selector(:popover-open) {
			/* Transparent, not removed: the header's height stays what .first-screen expects. */
			.site-header {
				border-bottom-color: transparent;
			}
			.menu-button {
				display: grid;
			}
			/* Puts the close icon exactly where the menu icon was. */
			.site-nav .menu-button {
				margin: -0.75rem -0.625rem 0 auto;
			}
			.site-nav {
				inset: 0 0 0 auto;
				box-sizing: border-box;
				width: min(20rem, 85vw);
				height: 100dvh;
				margin: 0;
				padding: 1rem;
				border: 0;
				border-left: 1px solid var(--border);
				background: var(--bg);
				color: inherit;
			}
			.site-nav::backdrop {
				background: color-mix(in srgb, var(--ink) 40%, transparent);
			}
			.site-nav ul {
				flex-direction: column;
				margin-top: 1rem;
			}
			.site-nav a {
				padding-block: 0.75rem;
			}
		}
	}
	/* Popover is only a small-screen behaviour: on wide screens the nav is a normal row. */
	@media (min-width: 60rem) {
		.site-nav {
			display: flex;
			align-items: center;
			gap: 1.25rem;
			position: static;
			inset: auto;
			width: auto;
			height: auto;
			margin: 0;
			padding: 0;
			overflow: visible;
			border: 0;
			background: none;
			color: inherit;
		}
		.site-nav ul {
			padding-bottom: 0;
		}
	}
</style>
