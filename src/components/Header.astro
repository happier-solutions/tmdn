---
import { SITE_TITLE } from '../consts';
---

<header>
	<div class="wrap">
		<a class="brand" href="/">
			<img src="/favicon.svg" width="40" height="40" alt="" />
			<span>{SITE_TITLE}</span>
		</a>
	</div>
</header>
<style>
	header {
		border-bottom: 1px solid var(--gold);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		padding-block: 0.75rem;
		color: rgb(var(--black));
		font-family: var(--font-heading);
		font-size: 1.25rem;
		text-decoration: none;
	}
	.brand img {
		display: block;
		border-radius: 0;
	}
</style>
