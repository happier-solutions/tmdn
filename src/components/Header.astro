---
import { AUTHOR, SITE_NAME } from '../consts';
import { PILLARS, type Topic, topicsOf, topicUrl } from '../data/taxonomy';
import ThemeSwitch from './ThemeSwitch.astro';

type NavItem = { href: string; label: string; topics?: Topic[] };

// The two pillars open their topics in a submenu.
const navItems: NavItem[] = [
	{ href: '/', label: 'Trang chủ' },
	{ href: '/gioi-thieu/', label: 'Giới thiệu' },
	...PILLARS.map(({ slug, label }) => ({ href: `/${slug}/`, label, topics: topicsOf(slug) })),
	{ href: '/bai-noi-bat/', label: 'Bài viết nổi bật' },
	{ href: '/cong-dong/', label: 'Cộng đồng' },
	{ href: '/lien-he/', label: 'Liên hệ' },
];

const { pathname } = Astro.url;

// 'page' on the section's own page, 'true' on anything inside it (a post, a topic).
const ariaCurrent = (href: string) => {
	if (pathname === href) return 'page';
	if (href !== '/' && pathname.startsWith(href)) return 'true';
	return undefined;
};
---


<header class="site-header">
	<div class="wrap wrap-wide bar">
		<a class="brand" href="/" aria-label={`${AUTHOR}, ${SITE_NAME}: trang chủ`}>
			<span class="seal" aria-hidden="true"></span>
			<span class="wordmark" aria-hidden="true">
				<span class="name">{AUTHOR}</span>
				<span class="site">{SITE_NAME}</span>
			</span>
		</a>
		<button class="menu-button" type="button" popovertarget="site-nav" aria-label="Mở menu">
			<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
				<path d="M4 6h16 M4 12h16 M4 18h16" />
			</svg>
		</button>
		<nav id="site-nav" class="site-nav" popover aria-label="Menu chính">
			<button class="menu-button" type="button" popovertarget="site-nav" popovertargetaction="hide" aria-label="Đóng menu">
				<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
					<path d="M6 6l12 12 M18 6L6 18" />
				</svg>
			</button>
			<ul class="nav-list">
				{navItems.map(({ href, label, topics }, i) =>
					topics ? (
						<li class="has-sub">
							<div class="item-head">
								<a {href} aria-current={ariaCurrent(href)}><span class="link-line">{label}</span></a>
								<button class="sub-toggle" type="button" aria-expanded="false" aria-controls={`nav-sub-${i}`} aria-label={`Chủ đề của ${label}`}>
									<svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
								</button>
							</div>
							<ul id={`nav-sub-${i}`} class="sub">
								{topics.map((topic) => (
									<li><a href={topicUrl(topic)} aria-current={ariaCurrent(topicUrl(topic))}><span class="link-line">{topic.label}</span></a></li>
								))}
							</ul>
						</li>
					) : (
						<li><a {href} aria-current={ariaCurrent(href)}><span class="link-line">{label}</span></a></li>
					),
				)}
			</ul>
			<ThemeSwitch />
		</nav>
	</div>
</header>
<script>
	const toggles = [...document.querySelectorAll<HTMLButtonElement>('.sub-toggle')];
	const setOpen = (toggle: HTMLButtonElement, open: boolean) => toggle.setAttribute('aria-expanded', String(open));

	for (const toggle of toggles) {
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			for (const other of toggles) setOpen(other, false);
			setOpen(toggle, open);
		});
	}
	// In the row, a submenu opened by click closes with Esc or a click elsewhere, like a menu.
	const row = matchMedia('(min-width: 72rem)');
	document.addEventListener('click', (event) => {
		if (!row.matches || (event.target as Element).closest('.has-sub')) return;
		for (const toggle of toggles) setOpen(toggle, false);
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || !row.matches) return;
		const open = toggles.find((toggle) => toggle.getAttribute('aria-expanded') === 'true');
		if (!open) return;
		setOpen(open, false);
		open.focus();
	});
</script>
<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}
	/* Pinned on desktop while reading, except on short windows where it would take too much height. */
	@media (min-width: 60rem) and (min-height: 34rem) {
		.site-header {
			position: sticky;
			top: 0;
			z-index: 1;
		}
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1.5rem;
	}
	/* A wordmark, not a link with a rule: the hover only shifts its color. */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding-block: 0.75rem;
		color: var(--text);
		background: none;
	}
	.brand::after {
		display: none;
	}
	.brand:hover {
		color: var(--bamboo);
	}
	/* A small seal: the logo's sprig cut out of seal red. */
	.seal {
		flex: none;
		width: 2rem;
		height: 2rem;
		background: var(--seal);
		mask:
			url('/sprig.svg') center / 1.375rem no-repeat exclude,
			linear-gradient(#000 0 0);
	}
	.wordmark {
		display: grid;
		line-height: 1.15;
	}
	.name {
		font-family: var(--font-heading);
		font-size: 1.1875rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.site {
		color: var(--text-2);
		font-size: 0.6875rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	/* A menu reads as one, so its links skip the rest rule every other link has. */
	.site-nav {
		--rest-line: 0;
	}
	.nav-list,
	.sub {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.nav-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5rem;
		padding-bottom: 0.75rem;
	}
	.site-nav a {
		display: block;
		padding-block: 0.5rem;
		color: var(--text);
		font-size: 0.875rem;
	}
	/* Every top-level menu item reads in the olive of the active item, so the bar is one color. */
	.nav-list > li > a,
	.item-head > a {
		color: var(--bamboo);
	}
	/* The current page is set apart by color alone; the rule and sprig stay hover details. */
	.site-nav a[aria-current] {
		color: var(--bamboo);
	}
	/* Forced colors drop the link color, so the state needs another mark there. */
	@media (forced-colors: active) {
		.site-nav a[aria-current] .link-line {
			text-decoration: underline;
		}
	}

	.item-head {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.sub-toggle {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--text-2);
		cursor: pointer;
	}
	.sub-toggle svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.sub-toggle[aria-expanded='true'] svg {
		rotate: 180deg;
	}
	@media (prefers-reduced-motion: no-preference) {
		.sub-toggle {
			transition: translate 200ms ease-out;
		}
	}
	@media (hover: hover) {
		.sub-toggle:hover {
			color: var(--bamboo);
		}
		/* Steps aside so the link's sprig has room to grow. Keyed to the whole row,
		   not the link, so it holds still while the pointer crosses to the toggle. */
		.item-head:hover .sub-toggle {
			translate: 0.625rem 0;
		}
	}
	.sub-toggle:focus-visible {
		outline: 2px solid var(--bamboo);
		outline-offset: 2px;
	}
	.sub {
		display: none;
	}
	.has-sub:has([aria-expanded='true']) .sub {
		display: block;
	}
	/* Without JS the toggles can't work, so every topic stays listed. */
	@media (scripting: none) {
		.sub-toggle {
			display: none;
		}
		.sub {
			display: block;
		}
	}

	/* Without popover support the links stay visible as a wrapped row. */
	.menu-button {
		display: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		/* Pulled out by the empty space around the icon, so the icon lines up with the page edge. */
		margin-inline-end: -0.625rem;
		padding: 0;
		border: 0;
		background: none;
		color: var(--text);
		cursor: pointer;
	}
	@media (hover: hover) {
		.menu-button:hover {
			color: var(--bamboo);
		}
	}
	.menu-button:focus-visible {
		outline: 2px solid var(--bamboo);
		outline-offset: 2px;
	}
	.menu-button svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
	}
	@media (max-width: 71.99rem) {
		@supports selector(:popover-open) {
			/* Transparent, not removed: the header's height stays what .first-screen expects. */
			.site-header {
				border-bottom-color: transparent;
			}
			.menu-button {
				display: grid;
			}
			/* Puts the close icon exactly where the menu icon was. */
			.site-nav .menu-button {
				margin: -0.75rem -0.625rem 0 auto;
			}
			.site-nav {
				inset: 0 0 0 auto;
				box-sizing: border-box;
				width: min(20rem, 85vw);
				height: 100dvh;
				margin: 0;
				padding: 1rem;
				border: 0;
				border-left: 1px solid var(--border);
				background: var(--bg);
				color: inherit;
				overscroll-behavior: contain;
			}
			.site-nav::backdrop {
				background: color-mix(in srgb, var(--ink) 40%, transparent);
			}
			/* The drawer slides in from the edge over a fading backdrop. The exit plays where
			   display and overlay can transition (Chromium, Safari); elsewhere it closes at once. */
			@media (prefers-reduced-motion: no-preference) {
				.site-nav,
				.site-nav::backdrop {
					transition:
						translate 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
						opacity 320ms ease-out,
						display 320ms,
						overlay 320ms;
					transition-behavior: allow-discrete;
				}
				.site-nav {
					translate: 100% 0;
				}
				.site-nav:popover-open {
					translate: 0;
				}
				.site-nav::backdrop {
					opacity: 0;
				}
				.site-nav:popover-open::backdrop {
					opacity: 1;
				}
				@starting-style {
					.site-nav:popover-open {
						translate: 100% 0;
					}
					.site-nav:popover-open::backdrop {
						opacity: 0;
					}
				}
			}
			.nav-list {
				flex-direction: column;
				margin-top: 1rem;
			}
			.nav-list > li > a,
			.item-head > a {
				padding-block: 0.75rem;
			}
			.item-head {
				justify-content: space-between;
			}
			/* A full tap target, pulled out so the chevron lines up with the close icon. */
			.sub-toggle {
				width: 2.75rem;
				height: 2.75rem;
				margin-inline-end: -0.875rem;
			}
			.sub {
				margin: 0 0 0.5rem;
				padding: 0 0 0 1rem;
				border-left: 1px solid var(--border);
			}
			.sub a {
				padding-block: 0.5rem;
				color: var(--text-2);
				line-height: 1.45;
			}
			/* Topics fade in as they unfold under the pillar. */
			.sub {
				transition:
					opacity 220ms ease-out,
					translate 220ms ease-out;
			}
			@starting-style {
				.has-sub:has([aria-expanded='true']) .sub {
					opacity: 0;
				}
			}
			@media (prefers-reduced-motion: no-preference) {
				@starting-style {
					.has-sub:has([aria-expanded='true']) .sub {
						translate: 0 -0.25rem;
					}
				}
			}
		}
	}
	/* Popover is only a small-screen behaviour: on wide screens the nav is a normal row. */
	@media (min-width: 72rem) {
		.site-nav {
			display: flex;
			align-items: center;
			gap: 1.25rem;
			position: static;
			inset: auto;
			width: auto;
			height: auto;
			margin: 0;
			padding: 0;
			overflow: visible;
			border: 0;
			background: none;
			color: inherit;
		}
		.nav-list {
			gap: 0 1.25rem;
			padding-bottom: 0;
		}
		.has-sub {
			position: relative;
		}
		.item-head {
			gap: 0.125rem;
		}
		/* A panel hanging from the header's bottom rule, opened by hover or the chevron. */
		.sub {
			position: absolute;
			top: calc(100% + 0.6875rem);
			left: -1.25rem;
			z-index: 2;
			width: max-content;
			max-width: 22rem;
			padding: 0.75rem 1.25rem;
			border: 1px solid var(--border);
			border-top-color: var(--wash);
			background: var(--wash);
		}
		/* Bridges the gap to the panel, so the pointer can travel down without closing it. */
		.sub::before {
			content: '';
			position: absolute;
			inset: -0.75rem 0 100%;
		}
		/* Kept in layout and hidden with visibility, so both opening and closing can fade
		   in every browser, and a closed panel still leaves the tab order and the a11y tree.
		   Closing is quicker than opening, so moving between pillars never shows two panels. */
		.sub {
			display: block;
			visibility: hidden;
			opacity: 0;
			transition:
				opacity 140ms ease-in,
				translate 140ms ease-in,
				visibility 0s 140ms;
		}
		.has-sub:has([aria-expanded='true']) .sub {
			visibility: visible;
			opacity: 1;
			transition:
				opacity 220ms ease-out,
				translate 220ms ease-out;
		}
		@media (hover: hover) {
			.has-sub:hover .sub {
				visibility: visible;
				opacity: 1;
				transition:
					opacity 220ms ease-out,
					translate 220ms ease-out;
			}
		}
		@media (scripting: none) {
			.has-sub:is(:hover, :focus-within) .sub {
				visibility: visible;
				opacity: 1;
				transition:
					opacity 220ms ease-out,
					translate 220ms ease-out;
			}
		}
		/* A short drop from the header rule, unless the reader asked for less motion. */
		@media (prefers-reduced-motion: no-preference) {
			.sub {
				translate: 0 -0.375rem;
			}
			.has-sub:has([aria-expanded='true']) .sub {
				translate: 0;
			}
			@media (hover: hover) {
				.has-sub:hover .sub {
					translate: 0;
				}
			}
			@media (scripting: none) {
				.has-sub:is(:hover, :focus-within) .sub {
					translate: 0;
				}
			}
		}
		.sub a {
			padding-block: 0.375rem;
			line-height: 1.45;
		}
	}
</style>
