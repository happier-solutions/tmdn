---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORIES, TAGS } from '../data/taxonomy';

const year = new Date().getFullYear();

const columns = [
	{
		title: 'Chuyên mục',
		links: [
			...CATEGORIES.map(({ slug, label }) => ({ href: `/${slug}/`, label })),
			{ href: '/bai-viet/', label: 'Tất cả bài viết' },
		],
	},
	{
		title: 'Chủ đề',
		links: [
			...TAGS.map(({ slug, label }) => ({ href: `/chu-de/${slug}/`, label })),
			{ href: '/chu-de/', label: 'Tất cả chủ đề' },
		],
	},
	{
		title: 'Về blog',
		links: [
			{ href: '/gioi-thieu/', label: 'Giới thiệu' },
			{ href: '/lien-he/', label: 'Liên hệ' },
			{ href: '/quy-tac-an-danh/', label: 'Quy tắc ẩn danh' },
			{ href: '/rss.xml', label: 'RSS' },
		],
	},
];
---

<footer>
	<div class="links">
		<div class="wrap wrap-wide columns">
			{columns.map(({ title, links }) => (
				<nav aria-label={title}>
					<h3>{title}</h3>
					<ul>
						{links.map(({ href, label }) => <li><a {href}>{label}</a></li>)}
					</ul>
				</nav>
			))}
		</div>
	</div>

	<div class="wrap wrap-wide legal">
		<img src="/favicon.svg" width="32" height="32" alt="" />
		<p>
			&copy; {year} {SITE_TITLE}<br />
			{SITE_DESCRIPTION}
		</p>
		<p class="credit">
			Thiết kế bởi <a href="https://happier.io.vn" target="_blank" rel="noopener">Happier Solutions</a>
		</p>
	</div>
</footer>

<style>
	footer {
		/* Always dark, so tokens and the focus outline resolve to their dark values here. */
		color-scheme: dark;
		background: var(--ink);
		color: var(--on-ink);
		font-size: 0.875rem;
	}
	a {
		color: var(--gold-light);
	}
	a:hover {
		color: var(--on-ink);
	}
	p {
		margin: 0;
	}

	/* A step of tone, not a rule, sets the links apart from Signup above and the legal row below. */
	.links {
		background: color-mix(in srgb, var(--on-ink) 6%, var(--ink));
	}
	.columns {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
		gap: 2.5rem 2rem;
		padding-block: 3rem;
	}
	h3 {
		margin-bottom: 0.75rem;
		color: var(--on-ink);
		font: 700 0.875rem / 1.7 var(--font-body);
	}
	ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.legal {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.5rem 0.75rem;
		align-items: center;
		padding-block: 1.5rem;
		/* Keeps the text clear of ScrollTop at the end of the page. */
		padding-inline-end: 3.5rem;
		color: color-mix(in srgb, var(--on-ink) 75%, transparent);
	}
	.legal img {
		display: block;
		border-radius: 0;
	}
	.credit {
		grid-column: 2;
	}
	@media (min-width: 60rem) {
		.legal {
			grid-template-columns: auto 1fr auto;
		}
		.credit {
			grid-column: 3;
		}
	}
	/* From here the column ends before ScrollTop starts. */
	@media (min-width: 80rem) {
		.legal {
			padding-inline-end: 1rem;
		}
	}
</style>
