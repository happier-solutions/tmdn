---
import { AUTHOR, SITE_MOTTO, SITE_NAME, SITE_TAGLINE } from '../consts';
import { PILLARS, topicsOf, topicUrl } from '../data/taxonomy';

const year = new Date().getFullYear();

const columns = [
	...PILLARS.map((pillar) => ({
		title: pillar.label,
		href: `/${pillar.slug}/`,
		links: topicsOf(pillar.slug).map((topic) => ({ href: topicUrl(topic), label: topic.label })),
	})),
	{
		title: 'Về trang',
		href: undefined,
		links: [
			{ href: '/gioi-thieu/', label: 'Giới thiệu' },
			{ href: '/bai-viet/', label: 'Tất cả bài viết' },
			{ href: '/tu-khoa/', label: 'Từ khóa' },
			{ href: '/lien-he/', label: 'Liên hệ' },
			{ href: '/quy-tac-an-danh/', label: 'Quy tắc ẩn danh' },
			{ href: '/rss.xml', label: 'RSS' },
		],
	},
];
---

<footer>
	<div class="links">
		<div class="wrap wrap-wide columns">
			<div class="about">
				<p class="name">{AUTHOR}</p>
				<p class="site">{SITE_NAME}</p>
				<p class="motto">{SITE_TAGLINE}<br />{SITE_MOTTO}</p>
			</div>
			{columns.map(({ title, href, links }) => (
				<nav aria-label={title}>
					<h3>{href ? <a {href}>{title}</a> : title}</h3>
					<ul>
						{links.map(({ href, label }) => <li><a {href}>{label}</a></li>)}
					</ul>
				</nav>
			))}
		</div>
	</div>

	<div class="wrap wrap-wide legal">
		<p>&copy; {year} {AUTHOR} · {SITE_NAME}</p>
		<p class="credit">
			Thiết kế bởi <a href="https://happier.io.vn" target="_blank" rel="noopener">Happier Solutions</a>
		</p>
	</div>
</footer>

<style>
	footer {
		/* Always dark, so tokens and the focus outline resolve to their dark values here. */
		color-scheme: dark;
		background: var(--ink);
		color: var(--on-ink);
		font-size: 0.875rem;
	}
	a {
		color: var(--gold-light);
	}
	a:hover {
		color: var(--on-ink);
	}
	p {
		margin: 0;
	}

	/* A step of tone, not a rule, sets the links apart from Signup above and the legal row below. */
	.links {
		background: color-mix(in srgb, var(--on-ink) 6%, var(--ink));
	}
	.columns {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: 2.5rem 2rem;
		padding-block: 3rem;
	}
	.about p + p {
		margin-top: 0.25rem;
	}
	.name {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.site {
		color: var(--gold-light);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.about .motto {
		margin-top: 1rem;
		color: color-mix(in srgb, var(--on-ink) 75%, transparent);
		line-height: 1.7;
	}
	h3 a {
		color: inherit;
	}
	h3 {
		margin-bottom: 0.75rem;
		color: var(--on-ink);
		font: 700 0.875rem / 1.7 var(--font-body);
	}
	ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.legal {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem 0.75rem;
		align-items: center;
		padding-block: 1.5rem;
		/* Keeps the text clear of ScrollTop at the end of the page. */
		padding-inline-end: 3.5rem;
		color: color-mix(in srgb, var(--on-ink) 75%, transparent);
	}
	@media (min-width: 60rem) {
		.legal {
			grid-template-columns: 1fr auto;
		}
	}
	/* From here the column ends before ScrollTop starts. */
	@media (min-width: 80rem) {
		.legal {
			padding-inline-end: 1rem;
		}
	}
</style>
