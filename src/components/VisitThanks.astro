<div class="visit-thanks">
	<div class="content"><slot /></div>
	<!-- Decorative: screen readers go straight to the content, which is only transparent until then. -->
	<div class="thanks" aria-hidden="true">
		<div class="inner">
			<p class="label">Bạn đã ở đây</p>
			<p class="time">0 giây</p>
			<span class="line"></span>
			<p class="text">Cảm ơn bạn đã dành thời gian đọc những ghi chép của tôi.</p>
		</div>
	</div>
</div>

<script>
	import { trackForegroundTime } from '../lib/foreground-time';

	const COUNT_UP = 900;
	const STORAGE_KEY = 'visit-thanked';

	const root = document.querySelector<HTMLElement>('.visit-thanks');
	const content = root?.querySelector<HTMLElement>('.content');
	const inner = root?.querySelector<HTMLElement>('.inner');
	const time = root?.querySelector<HTMLElement>('.time');

	// Storage can throw when the browser blocks it. The thanks then just plays on every visit.
	function alreadyThanked() {
		try {
			return sessionStorage.getItem(STORAGE_KEY) !== null;
		} catch {
			return false;
		}
	}
	function rememberThanks() {
		try {
			sessionStorage.setItem(STORAGE_KEY, '1');
		} catch {}
	}

	function format(ms: number) {
		const total = Math.floor(ms / 1000);
		const hours = Math.floor(total / 3600);
		const minutes = Math.floor((total % 3600) / 60);
		const seconds = total % 60;
		if (hours) return `${hours} giờ ${minutes} phút`;
		return minutes ? `${minutes} phút ${seconds} giây` : `${seconds} giây`;
	}

	if (root && content && inner && time && !alreadyThanked()) {
		const foregroundTime = trackForegroundTime();

		const play = () => {
			const start = performance.now();
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const tick = (now: number) => {
				if (!root.dataset.thanks) return;
				const progress = reduced ? 1 : Math.min((now - start) / COUNT_UP, 1);
				const text = format(foregroundTime() * (1 - (1 - progress) ** 3));
				if (time.textContent !== text) time.textContent = text;
				requestAnimationFrame(tick);
			};
			root.dataset.thanks = 'play';
			requestAnimationFrame(tick);
		};

		const observer = new IntersectionObserver(
			([entry]) => {
				if (!entry.isIntersecting) return;
				observer.disconnect();
				play();
			},
			{ threshold: 0.5, rootMargin: '0px 0px -10% 0px' },
		);

		const finish = () => {
			observer.disconnect();
			delete root.dataset.thanks;
			rememberThanks();
		};

		root.dataset.thanks = 'wait';
		observer.observe(inner);
		// The content's fade is the last step. A keyboard reader arriving early doesn't have to wait for it.
		content.addEventListener('animationend', (event) => {
			if (event.target === content) finish();
		});
		content.addEventListener('focusin', finish);
	}
</script>

<style>
	.thanks {
		display: none;
	}

	/* Screen only, so a paused animation can't print as an empty section. */
	@media screen {
		[data-thanks] {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
		}
		/* Stacked, so the thanks takes the content's space and nothing below it moves. */
		[data-thanks] > * {
			grid-area: 1 / 1;
		}
		[data-thanks] > .content {
			animation: thanks-fade 700ms ease-out 4400ms backwards;
		}
		[data-thanks] > .thanks {
			display: block;
			pointer-events: none;
			animation: thanks-out 400ms ease-in 4000ms forwards;
		}
		[data-thanks='wait'] > *,
		[data-thanks='wait'] .text,
		[data-thanks='wait'] .line::before,
		[data-thanks='wait'] .line::after {
			animation-play-state: paused;
		}

		/* Stays in view while the reader scrolls through the content's space. */
		.inner {
			position: sticky;
			top: max(6rem, 30svh);
			padding-block: 2rem;
			text-align: center;
		}
		p {
			margin: 0;
		}
		.label {
			color: var(--gray);
			font-size: 1rem;
		}
		.time {
			color: var(--black);
			font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
			font-variant-numeric: tabular-nums;
			line-height: 1.25;
		}
		.line {
			position: relative;
			display: block;
			width: min(14rem, 60%);
			height: 1px;
			margin: 1.25rem auto;
		}
		.line::before {
			content: '';
			position: absolute;
			inset: 0;
			background: var(--gold);
			transform-origin: left;
		}
		/* The logo's sprig, growing from the rule's end as in `links.css`. */
		.line::after {
			content: '';
			position: absolute;
			bottom: -0.25rem;
			left: 100%;
			width: 1.5rem;
			height: 1.65rem;
			background: var(--gold);
			mask: url('/sprig.svg') center / contain no-repeat;
			transform-origin: left bottom;
		}
		.text {
			color: var(--gray-dark);
			font-family: var(--font-heading);
			font-size: 1.25rem;
			line-height: 1.25;
			text-wrap: balance;
			animation: thanks-fade 500ms ease-out 1100ms backwards;
		}

		@media (prefers-reduced-motion: no-preference) {
			.line::before {
				animation: thanks-draw 900ms cubic-bezier(0.2, 0.6, 0.4, 1) backwards;
			}
			.line::after {
				animation: thanks-leaf 260ms ease-out 900ms backwards;
			}
			.text,
			[data-thanks] > .content {
				animation-name: thanks-rise;
			}
		}
	}

	@keyframes thanks-fade {
		from {
			opacity: 0;
		}
	}
	@keyframes thanks-rise {
		from {
			opacity: 0;
			translate: 0 0.5rem;
		}
	}
	@keyframes thanks-out {
		to {
			opacity: 0;
		}
	}
	@keyframes thanks-draw {
		from {
			transform: scaleX(0);
		}
	}
	@keyframes thanks-leaf {
		from {
			rotate: 40deg;
			scale: 0;
		}
	}
</style>
