---
import { SITE_TITLE } from '../consts';

const url = new URL(Astro.url.pathname, Astro.site).href;
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<section class="share" aria-label="Chia sẻ bài viết" data-url={url}>
	<a href={facebook} target="_blank" rel="noopener" aria-label="Chia sẻ lên Facebook" title="Chia sẻ lên Facebook">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
		</svg>
	</a>
	<button type="button" data-action="copy" aria-label="Sao chép liên kết" title="Sao chép liên kết">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
			<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
		</svg>
	</button>
	<button type="button" data-action="thanks" aria-label="Thả tim cho bài viết" title="Thả tim cho bài viết">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
		</svg>
		<span class="hearts" aria-hidden="true"></span>
	</button>
	<p class="sr-only" role="status"></p>
	<div class="toast" popover="manual" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="16" height="16">
			<path d="M5 12.5l4.5 4.5L19 7.5" />
		</svg>
		<span></span>
	</div>
	<dialog class="thanks" closedby="any" aria-labelledby="thanks-title" aria-describedby="thanks-body">
		<div class="letter">
			<p class="date"></p>
			<p class="greeting">Gửi bạn,</p>
			<h2 id="thanks-title">Cảm ơn bạn đã thả tim</h2>
			<div id="thanks-body">
				<p class="proverb"></p>
				<p class="wish"></p>
				<p class="closing">Thân mến,</p>
				<p class="signature">{SITE_TITLE}</p>
			</div>
		</div>
		<svg class="pocket" viewBox="0 0 400 160" aria-hidden="true">
			<path class="side" d="M0 0 160 160H0ZM400 0 240 160H400Z" />
			<path class="front" d="M80 160 170 70Q200 40 230 70L320 160Z" />
		</svg>
		<svg class="flap" viewBox="0 0 400 160" aria-hidden="true">
			<path d="M0 0H400L225 95Q200 117 175 95Z" />
		</svg>
		<form method="dialog">
			<button autofocus>Đóng</button>
		</form>
	</dialog>
</section>
<script>
	import { readHearts, saveHearts } from '../lib/post-hearts';
	import { pickThanksMessage, type ThanksMessage } from '../lib/thanks-messages';

	const share = document.querySelector<HTMLElement>('.share');
	const status = share?.querySelector('[role="status"]');
	const toast = share?.querySelector<HTMLElement>('.toast');
	const toastText = toast?.querySelector('span');
	const heart = share?.querySelector<HTMLElement>('[data-action="thanks"]');
	const heartCount = heart?.querySelector('.hearts');
	const thanks = share?.querySelector('dialog');
	const thanksTitle = thanks?.querySelector('h2');
	const thanksDate = thanks?.querySelector('.date');
	const proverb = thanks?.querySelector('.proverb');
	const wish = thanks?.querySelector('.wish');
	if (share && status && toast && toastText && heart && heartCount && thanks && thanksTitle && thanksDate && proverb && wish) {
		const { url = '' } = share.dataset;
		let timer: ReturnType<typeof setTimeout>;
		// Fades out before leaving the top layer, since Firefox and Safari can't animate that exit.
		const hide = async () => {
			toast.dataset.state = 'closing';
			await Promise.allSettled(toast.getAnimations().map(({ finished }) => finished));
			if (toast.dataset.state !== 'closing') return;
			delete toast.dataset.state;
			toast.hidePopover?.();
			status.textContent = '';
		};
		// A hidden popover isn't in the accessibility tree, so screen readers get their own live region.
		const say = (text: string, ok = true) => {
			status.textContent = text;
			toastText.textContent = text;
			toast.toggleAttribute('data-failed', !ok);
			if (!toast.dataset.state) toast.showPopover?.();
			toast.dataset.state = 'open';
			clearTimeout(timer);
			timer = setTimeout(hide, 4000);
		};
		const copy = async () => {
			try {
				await navigator.clipboard.writeText(url);
				say('Đã sao chép liên kết');
			} catch {
				say('Không sao chép được liên kết', false);
			}
		};
		const path = new URL(url).pathname;
		let hearts = readHearts(path);
		const showHearts = () => {
			const label = hearts ? `Thả tim cho bài viết, bạn đã thả ${hearts} lần` : 'Thả tim cho bài viết';
			heart.ariaLabel = label;
			heart.title = label;
			heart.toggleAttribute('data-hearted', hearts > 0);
			heartCount.textContent = hearts > 99 ? '99+' : hearts ? String(hearts) : '';
		};
		showHearts();
		let message: ThanksMessage | undefined;
		const showThanks = () => {
			// Read again, as another tab may have added to it.
			hearts = Math.max(hearts, readHearts(path)) + 1;
			saveHearts(path, hearts);
			showHearts();
			thanksTitle.textContent = hearts > 1 ? `Cảm ơn bạn đã thả tim lần thứ ${hearts}` : 'Cảm ơn bạn đã thả tim';
			const today = new Date();
			thanksDate.textContent = `Ngày ${today.getDate()} tháng ${today.getMonth() + 1} năm ${today.getFullYear()}`;
			message = pickThanksMessage(message);
			proverb.textContent = message.proverb;
			wish.textContent = message.wish;
			thanks.showModal();
			// On a short screen, focus on the button would open the letter at its end.
			thanks.scrollTop = 0;
		};
		// Every way out comes through here, so the letter can fold away before the dialog leaves the top layer.
		const closeThanks = async () => {
			if (thanks.hasAttribute('data-closing')) return;
			thanks.toggleAttribute('data-closing', true);
			await Promise.allSettled(thanks.getAnimations({ subtree: true }).map(({ finished }) => finished));
			// A second Esc can close it natively in the meantime.
			if (thanks.hasAttribute('data-closing')) thanks.close();
		};
		thanks.addEventListener('close', () => thanks.removeAttribute('data-closing'));
		for (const type of ['submit', 'cancel']) {
			thanks.addEventListener(type, (event) => {
				event.preventDefault();
				closeThanks();
			});
		}
		share.addEventListener('click', ({ target }) => {
			const action = (target as Element).closest('button')?.dataset.action;
			if (action === 'copy') copy();
			if (action === 'thanks') showThanks();
		});
		// Safari has no closedby. Press and release must both land outside, so a text selection dragged out doesn't close it.
		if (!('closedBy' in HTMLDialogElement.prototype)) {
			const outside = ({ clientX: x, clientY: y }: PointerEvent) => {
				const { left, right, top, bottom } = thanks.getBoundingClientRect();
				return x < left || x > right || y < top || y > bottom;
			};
			let pressedOutside = false;
			thanks.addEventListener('pointerdown', (event) => {
				pressedOutside = outside(event);
			});
			thanks.addEventListener('pointerup', (event) => {
				if (pressedOutside && outside(event)) closeThanks();
			});
		}
	}
</script>
<style>
	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	.share > a,
	.share > button {
		position: relative;
		display: grid;
		place-items: center;
		box-sizing: border-box;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid var(--gold);
		border-radius: 50%;
		background: none;
		color: var(--gray-dark);
		cursor: pointer;
	}
	a::after {
		display: none;
	}
	@media (hover: hover) {
		.share > a:hover,
		.share > button:hover {
			border-color: var(--accent);
			color: var(--accent);
		}
	}
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.share > button[data-hearted] svg {
		fill: var(--gold);
	}
	.hearts {
		position: absolute;
		top: -0.25rem;
		right: -0.25rem;
		box-sizing: border-box;
		min-width: 1rem;
		padding-inline: 0.25rem;
		border-radius: 1.25rem;
		background: var(--accent);
		color: var(--paper);
		font-size: 0.75rem;
		line-height: 1rem;
		text-align: center;
		pointer-events: none;
	}
	.hearts:empty {
		display: none;
	}
	.toast {
		--rise: 0.5rem;
		display: none;
		position: fixed;
		inset: auto 0 1.5rem;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		max-width: calc(100vw - 2rem);
		margin: 0 auto;
		padding: 0.5rem 1rem;
		border: 0;
		border-radius: 1.25rem;
		background: var(--black);
		color: var(--paper);
		font-size: 0.875rem;
		line-height: 1.5;
		pointer-events: none;
		transition:
			opacity 220ms ease-out,
			transform 220ms ease-out;
	}
	.toast[data-state] {
		display: flex;
	}
	.toast[data-state='closing'] {
		opacity: 0;
		transform: translateY(var(--rise));
	}
	@starting-style {
		.toast[data-state] {
			opacity: 0;
			transform: translateY(var(--rise));
		}
	}
	.toast svg {
		flex-shrink: 0;
		color: var(--gold);
	}
	.toast[data-failed] svg {
		display: none;
	}
	.thanks {
		box-sizing: border-box;
		width: min(28rem, 100vw - 2rem);
		margin: auto;
		padding: 0;
		border: 0;
		/* Every line of text sits on this grid, so it stays on the rules. */
		--line: 1.875rem;
		background-color: var(--gray-light);
		color: var(--gray-dark);
		font-family: var(--font-hand);
		font-size: 1.1875rem;
		line-height: var(--line);
		overscroll-behavior: contain;
		transition: opacity 200ms ease-out;
	}
	.thanks[data-closing] {
		opacity: 0;
	}
	.thanks::backdrop {
		overflow: hidden;
		overscroll-behavior: contain;
		background: color-mix(in srgb, var(--ink) 60%, transparent);
		transition: background-color 200ms ease-out;
	}
	.thanks[data-closing]::backdrop {
		background: transparent;
	}
	@starting-style {
		.thanks[open] {
			opacity: 0;
		}
		.thanks[open]::backdrop {
			background: transparent;
		}
	}
	/* Esc turns on focus rings: skip them on the dialog, which holds focus after a click on the letter, and on the way out. */
	.thanks:focus-visible,
	.thanks[data-closing] button {
		outline: none;
	}
	.thanks p {
		margin: 0;
	}
	/* Bottom padding keeps the text clear of the flaps. */
	.letter {
		position: relative;
		z-index: 1;
		transform-origin: 50% 100%;
		margin: 1.5rem 6% 0;
		padding: var(--line) 1.5rem 31%;
		background: conic-gradient(from 180deg at 75% calc(100% - 1px), color-mix(in oklab, var(--gold) 60%, transparent) 90deg, transparent 0) 0 -5px / 1.25rem var(--line) var(--paper);
	}
	.thanks .date {
		margin-bottom: var(--line);
		color: var(--gray);
		font-size: 1rem;
		text-align: end;
	}
	.thanks h2 {
		margin: 0;
		font-family: inherit;
		font-size: 1.5rem;
		line-height: inherit;
	}
	.thanks .proverb {
		margin-block: var(--line);
		padding-inline-start: 1rem;
		color: var(--accent);
		white-space: pre-line;
		text-wrap: pretty;
	}
	.thanks .wish {
		text-wrap: pretty;
	}
	.thanks .closing {
		margin-top: var(--line);
		text-align: end;
	}
	.thanks .signature {
		color: var(--black);
		text-align: end;
	}
	/* The envelope stays put, so a letter too long to fit slides out of it as it scrolls. */
	.pocket,
	.flap,
	.thanks form,
	.thanks::after {
		position: sticky;
		bottom: 0;
		display: block;
		margin-top: -40%;
	}
	/* Pinned, the envelope would leave too little of a short screen to read in. */
	@media (max-height: 34rem) {
		.pocket,
		.flap,
		.thanks form,
		.thanks::after {
			position: relative;
			bottom: auto;
		}
	}
	.pocket,
	.flap {
		width: 100%;
		height: auto;
		stroke: var(--gold);
		stroke-width: 1;
	}
	.pocket {
		z-index: 2;
	}
	.side {
		fill: color-mix(in oklab, var(--gold) 45%, var(--paper));
	}
	.front {
		fill: color-mix(in oklab, var(--gold) 30%, var(--paper));
	}
	/* Open, the top flap is out of sight behind the letter. */
	.flap {
		z-index: 0;
		visibility: hidden;
		fill: color-mix(in oklab, var(--gold) 65%, var(--paper));
		/* A flat flip. rotateX would swing its box toward the viewer and past the dialog's edges, which adds scrollbars. */
		transform: scaleY(-1);
		transform-origin: 50% 0;
	}
	.thanks form {
		z-index: 4;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		aspect-ratio: 5 / 2;
	}
	/* The envelope's back, behind the letter. */
	.thanks::after {
		content: '';
		z-index: -1;
		aspect-ratio: 2;
		margin-top: -50%;
		background: color-mix(in oklab, var(--gold) 65%, var(--paper));
		clip-path: polygon(10% 0, 90% 0, 100% 20%, 100% 100%, 0 100%, 0 20%);
	}
	/* A wax seal on the flap. The transparent border draws its edge in forced colors. */
	.thanks button {
		/* Scales down so it stays inside the flap on the narrowest phones. */
		width: clamp(3rem, 18%, 3.5rem);
		aspect-ratio: 1;
		margin-bottom: 5%;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 48% 52% 50% 50% / 52% 48% 52% 48%;
		background: var(--accent);
		box-shadow: inset 0 0 0 2px var(--accent), inset 0 0 0 3px var(--paper);
		color: var(--paper);
		font: inherit;
		cursor: pointer;
	}
	.thanks button:hover {
		--accent: var(--accent-dark);
	}
	@media (prefers-reduced-motion: reduce) {
		.toast {
			--rise: 0;
		}
	}
	/* Opens in three steps: the flap lifts, the letter unfolds, the paper behind fades in. Closing runs them back. */
	@media (prefers-reduced-motion: no-preference) {
		.thanks {
			--folded: perspective(60rem) rotateX(90deg);
			--shut: scaleY(1);
			--flat: polygon(10% 20%, 90% 20%, 100% 20%, 100% 100%, 0 100%, 0 20%);
			transition:
				opacity 120ms ease-out,
				background-color 180ms ease-out 350ms;
		}
		.letter {
			transition: transform 300ms ease-out 350ms;
		}
		/* The flap swaps layers halfway, while it is edge-on and can't be seen. */
		.flap {
			transition:
				transform 300ms ease-in-out 100ms,
				z-index 0s linear 250ms,
				visibility 0s linear 650ms;
		}
		/* The back's corners only stand above the envelope once the flap has lifted. */
		.thanks::after {
			transition: clip-path 150ms ease-out 250ms;
		}
		.thanks[data-closing]::after {
			clip-path: var(--flat);
			transition: clip-path 100ms ease-in 170ms;
		}
		.thanks[data-closing] {
			background-color: transparent;
			transition:
				opacity 120ms ease-in 370ms,
				background-color 100ms ease-out;
		}
		.thanks[data-closing]::backdrop {
			transition: background-color 120ms ease-in 370ms;
		}
		.thanks[data-closing] .letter {
			transform: var(--folded);
			transition: transform 200ms ease-in;
		}
		.thanks[data-closing] .flap {
			z-index: 3;
			visibility: visible;
			transform: var(--shut);
			transition:
				transform 200ms ease-in-out 170ms,
				z-index 0s linear 270ms,
				visibility 0s;
		}
		@starting-style {
			.thanks[open] {
				background-color: transparent;
			}
			.thanks[open]::after {
				clip-path: var(--flat);
			}
			.thanks[open] .letter {
				transform: var(--folded);
			}
			.thanks[open] .flap {
				z-index: 3;
				visibility: visible;
				transform: var(--shut);
			}
		}
	}
	/* The rail beside the post, from the same width as the grid in PostLayout. */
	@media (min-width: 64rem) {
		.share {
			flex-direction: column;
			flex-wrap: nowrap;
			align-items: flex-end;
		}
		.share > a,
		.share > button {
			width: 2.25rem;
			height: 2.25rem;
		}
	}
	/* Both buttons run on JS. The Facebook link doesn't. */
	@media (scripting: none) {
		.share > button {
			display: none;
		}
	}
</style>
