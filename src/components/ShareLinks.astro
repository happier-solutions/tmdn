---
interface Props {
	title: string;
}

const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---

<section class="share" aria-label="Chia sẻ bài viết" data-url={url} data-title={title}>
	<a href={facebook} target="_blank" rel="noopener" aria-label="Chia sẻ lên Facebook" title="Chia sẻ lên Facebook">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
		</svg>
	</a>
	<button type="button" data-action="zalo" aria-label="Chia sẻ qua Zalo" title="Chia sẻ qua Zalo">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path d="M6 6h12L6 18h12" />
		</svg>
	</button>
	<button type="button" data-action="copy" aria-label="Sao chép liên kết" title="Sao chép liên kết">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
			<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
		</svg>
	</button>
	<p class="sr-only" role="status"></p>
	<div class="toast" popover="manual" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="16" height="16">
			<path d="M5 12.5l4.5 4.5L19 7.5" />
		</svg>
		<span></span>
	</div>
</section>
<script>
	const share = document.querySelector<HTMLElement>('.share');
	const status = share?.querySelector('[role="status"]');
	const toast = share?.querySelector<HTMLElement>('.toast');
	const toastText = toast?.querySelector('span');
	if (share && status && toast && toastText) {
		const { url = '', title = '' } = share.dataset;
		let timer: ReturnType<typeof setTimeout>;
		// Fades out before leaving the top layer, since Firefox and Safari can't animate that exit.
		const hide = async () => {
			toast.dataset.state = 'closing';
			await Promise.allSettled(toast.getAnimations().map(({ finished }) => finished));
			if (toast.dataset.state !== 'closing') return;
			delete toast.dataset.state;
			toast.hidePopover?.();
			status.textContent = '';
		};
		// A hidden popover isn't in the accessibility tree, so screen readers get their own live region.
		const say = (text: string, ok = true) => {
			status.textContent = text;
			toastText.textContent = text;
			toast.toggleAttribute('data-failed', !ok);
			if (!toast.dataset.state) toast.showPopover?.();
			toast.dataset.state = 'open';
			clearTimeout(timer);
			timer = setTimeout(hide, 4000);
		};
		const copy = async (done: string) => {
			try {
				await navigator.clipboard.writeText(url);
				say(done);
			} catch {
				say('Không sao chép được liên kết', false);
			}
		};
		// Zalo's own button needs its SDK and an Official Account, so the link goes through the phone's
		// share sheet, which lists Zalo when it's installed, or through the clipboard on a computer.
		const shareToZalo = async () => {
			const toClipboard = () => copy('Đã sao chép liên kết, hãy dán vào Zalo');
			if (!navigator.share || !matchMedia('(pointer: coarse)').matches) return toClipboard();
			try {
				await navigator.share({ title, url });
			} catch (error) {
				if ((error as Error).name !== 'AbortError') await toClipboard();
			}
		};
		share.addEventListener('click', ({ target }) => {
			const action = (target as Element).closest('button')?.dataset.action;
			if (action === 'copy') copy('Đã sao chép liên kết');
			if (action === 'zalo') shareToZalo();
		});
	}
</script>
<style>
	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 2.5rem;
	}
	a,
	button {
		display: grid;
		place-items: center;
		box-sizing: border-box;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid var(--gold);
		border-radius: 50%;
		background: none;
		color: var(--gray-dark);
		cursor: pointer;
	}
	a::after {
		display: none;
	}
	@media (hover: hover) {
		a:hover,
		button:hover {
			border-color: var(--accent);
			color: var(--accent);
		}
	}
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.toast {
		--rise: 0.5rem;
		display: none;
		position: fixed;
		inset: auto 0 1.5rem;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		max-width: calc(100vw - 2rem);
		margin: 0 auto;
		padding: 0.5rem 1rem;
		border: 0;
		border-radius: 1.25rem;
		background: var(--black);
		color: var(--paper);
		font-size: 0.875rem;
		line-height: 1.5;
		pointer-events: none;
		transition:
			opacity 220ms ease-out,
			transform 220ms ease-out;
	}
	.toast[data-state] {
		display: flex;
	}
	.toast[data-state='closing'] {
		opacity: 0;
		transform: translateY(var(--rise));
	}
	@starting-style {
		.toast[data-state] {
			opacity: 0;
			transform: translateY(var(--rise));
		}
	}
	.toast svg {
		flex-shrink: 0;
		color: var(--gold);
	}
	.toast[data-failed] svg {
		display: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.toast {
			--rise: 0;
		}
	}
	/* The rail beside the post, from the same width as the grid in PostLayout. */
	@media (min-width: 64rem) {
		.share {
			position: sticky;
			top: 6rem;
			flex-direction: column;
			flex-wrap: nowrap;
			align-items: flex-end;
			align-self: start;
			justify-self: end;
			margin-top: 0;
		}
		a,
		button {
			width: 2.25rem;
			height: 2.25rem;
		}
	}
	/* Both buttons run on JS. The Facebook link doesn't. */
	@media (scripting: none) {
		button {
			display: none;
		}
	}
</style>
