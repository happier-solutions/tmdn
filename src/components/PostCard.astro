---
import { getReadingMinutes, type Post, postUrl } from '../lib/posts';
import PostLabel from './PostLabel.astro';
import Thumb from './Thumb.astro';

interface Props {
	post: Post;
	/** A large numeral above the card, for a ranked selection. */
	number?: number;
	topicOnly?: boolean;
	level?: 2 | 3;
}

const { post, number, topicOnly = false, level = 3 } = Astro.props;
const { title, description } = post.data;
const Heading = `h${level}` as const;
---

{/* A column in a selection: picture on top, title, standfirst. */}
<article class="card">
	{number !== undefined && <p class="number" aria-hidden="true">{String(number).padStart(2, '0')}</p>}
	<Thumb {post} class="card-thumb" sizes="(min-width: 56rem) 22rem, (min-width: 40rem) 45vw, 100vw" widths={[480, 720, 960]} />
	<PostLabel {post} {topicOnly} />
	<Heading class="title"><a href={postUrl(post)}>{title}</a></Heading>
	<p class="dek">{description}</p>
	<p class="meta">{getReadingMinutes(post)} phút đọc</p>
</article>
<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
	}
	.number {
		margin: 0 0 0.25rem;
		color: var(--gold);
		font-family: var(--font-heading);
		font-size: 2.5rem;
		font-variant-numeric: lining-nums;
		line-height: 1;
	}
	.card :global(.card-thumb) {
		margin-bottom: 0.5rem;
		aspect-ratio: 3 / 2;
	}
	.title {
		margin: 0;
		font-size: 1.3125rem;
		line-height: 1.3;
	}
	.title a {
		color: inherit;
	}
	.title a::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}
	.title a:focus-visible {
		outline: none;
	}
	.card:has(.title a:focus-visible) {
		outline: 2px solid var(--bamboo);
		outline-offset: 0.5rem;
	}
	.dek {
		margin: 0;
		color: var(--text-2);
		font-size: 0.9375rem;
		line-height: 1.6;
		text-wrap: pretty;
	}
	.meta {
		margin: auto 0 0;
		padding-top: 0.25rem;
	}
</style>
