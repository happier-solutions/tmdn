---
import { CONFIDENCE_LEVELS, TAGS } from '../data/taxonomy';
import { getSyllables, type Post, postUrl } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	/** Published posts, newest first. At least one. */
	posts: Post[];
}

const { posts } = Astro.props;
const number = new Intl.NumberFormat('vi-VN');

// Icons are stroke paths on a 32x32 grid, drawn like CategoryIcon.
const figures = [
	{
		label: 'Bài đã đăng',
		value: posts.length,
		// A page with a folded corner.
		icon: 'M4 3h16l7 7v19H4Z M20 3v7h7 M10 15h11 M10 20h11 M10 25h6',
	},
	{
		label: 'Chữ đã viết',
		value: posts.reduce((sum, post) => sum + getSyllables(post), 0),
		// A feather.
		icon: 'M27 5c-8-1-15 2-18 9-1.6 3.7-2 7-2 9 2 0 5.3-.4 9-2 7-3 10-10 11-16Z M4 28l16-16',
	},
	{
		label: 'Chủ đề đã viết',
		value: new Set(posts.flatMap((post) => post.data.tags)).size,
		// A tag.
		icon: 'M4 4h11l13 13a2 2 0 0 1 0 2.8L19.8 28a2 2 0 0 1-2.8 0L4 15Z M10 8a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z',
	},
	{
		label: 'Lần đổi quan điểm',
		value: posts.filter((post) => post.data.changedMindNote).length,
		// Two arrows turning back on each other.
		icon: 'M4 10h24 M22 4l6 6-6 6 M28 22H4 M10 16l-6 6 6 6',
	},
];

// Topics are ranked. Confidence keeps its own order, from first look to checked.
const breakdowns = [
	{
		title: 'Theo chủ đề',
		items: TAGS.map(({ slug, label }) => ({
			label,
			href: `/chu-de/${slug}/`,
			count: posts.filter((post) => (post.data.tags as string[]).includes(slug)).length,
		})).sort((a, b) => b.count - a.count),
	},
	{
		title: 'Theo độ chắc chắn',
		items: CONFIDENCE_LEVELS.map(({ slug, label }) => ({
			label,
			href: undefined,
			count: posts.filter((post) => post.data.confidence === slug).length,
		})),
	},
];

// The running total: x is time, y counts down from the top, both as 0-100 for the plot's viewBox.
const total = posts.length;
const first = posts[total - 1].data.pubDate;
const last = posts[0].data.pubDate;
const span = last.valueOf() - first.valueOf();
const points = posts.toReversed().map((post, index) => ({
	post,
	total: index + 1,
	x: span ? ((post.data.pubDate.valueOf() - first.valueOf()) / span) * 100 : 0,
	y: 100 - ((index + 1) / total) * 100,
}));
const line = points.map(({ x, y }) => `${x} ${y}`).join(' L');
const area = `M${points[0].x} 100 L${line} L${points[total - 1].x} 100 Z`;
const ticks = [...new Set([0, Math.ceil(total / 2), total])];
---

<div class="ruled stats">
	{figures.map(({ label, value, icon }) => (
		<div class="cell figure">
			<svg class="icon" viewBox="0 0 32 32" aria-hidden="true"><path d={icon} /></svg>
			<p class="value" data-count={value}>{number.format(value)}</p>
			<p class="label">{label}</p>
		</div>
	))}

	<div class="cell timeline">
		<h3>Số bài theo thời gian</h3>
		<div class="plot" aria-hidden="true">
			{ticks.map((tick) => (
				<span class="tick" style={`--y: ${100 - (tick / total) * 100}`}>{tick}</span>
			))}
			<svg viewBox="0 0 100 100" preserveAspectRatio="none">
				<path class="area" d={area} />
				<path class="line" d={`M${line}`} />
			</svg>
			{points.map(({ post, total: running, x, y }) => (
				<span class="point" style={`--x: ${x}; --y: ${y}`}>
					<span class="dot" />
					<span class:list={['tip', y < 50 ? 'below' : 'above']}>
						<strong>Tổng {running} bài</strong>
						<FormattedDate date={post.data.pubDate} />
						<span>{post.data.title}</span>
					</span>
				</span>
			))}
		</div>
		<div class="axis">
			<FormattedDate date={first} />
			{span > 0 && <FormattedDate date={last} />}
		</div>
		<details>
			<summary>Xem dạng bảng</summary>
			<table>
				<thead>
					<tr><th scope="col">Ngày</th><th scope="col">Bài viết</th><th scope="col">Tổng</th></tr>
				</thead>
				<tbody>
					{points.toReversed().map(({ post, total: running }) => (
						<tr>
							<td><FormattedDate date={post.data.pubDate} /></td>
							<td><a href={postUrl(post)}>{post.data.title}</a></td>
							<td>{running}</td>
						</tr>
					))}
				</tbody>
			</table>
		</details>
	</div>

	{breakdowns.map(({ title, items }) => {
		const max = Math.max(...items.map(({ count }) => count), 1);
		return (
			<div class="cell breakdown">
				<h3>{title}</h3>
				<ul>
					{items.map(({ label, href, count }) => (
						<li>
							{href ? <a {href}>{label}</a> : label}
							<div class="meter">
								<span class="bar" style={`--share: ${count / max}`} />
								<span>{count}</span>
							</div>
						</li>
					))}
				</ul>
			</div>
		);
	})}
</div>

<script>
	// The real number is in the HTML, so nothing moves without script or under reduced motion.
	const DURATION = 900;
	const number = new Intl.NumberFormat('vi-VN');
	const figures = document.querySelectorAll<HTMLElement>('[data-count]');
	const show = (figure: HTMLElement, value: number) => {
		figure.textContent = number.format(value);
	};

	function countUp(figure: HTMLElement) {
		const target = Number(figure.dataset.count);
		const start = performance.now();
		const tick = (now: number) => {
			const progress = Math.min((now - start) / DURATION, 1);
			show(figure, Math.round(target * (1 - (1 - progress) ** 3)));
			if (progress < 1) requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	}

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.unobserve(entry.target);
					countUp(entry.target as HTMLElement);
				}
			},
			{ threshold: 0.6 },
		);
		for (const figure of figures) {
			show(figure, 0);
			observer.observe(figure);
		}
		// Printing never scrolls, so figures still waiting would print as 0.
		addEventListener('beforeprint', () => {
			observer.disconnect();
			for (const figure of figures) show(figure, Number(figure.dataset.count));
		});
	}
</script>

<style>
	h3 {
		margin: 0;
		font-size: 1.25rem;
	}
	p {
		margin: 0;
	}

	/* The negative margin lines the drawing, 4 units in from the grid's edge, up with the text. */
	.icon {
		display: block;
		width: 2rem;
		height: 2rem;
		margin: 0 0 1rem -0.25rem;
		color: var(--accent);
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4px;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* Lining figures: Playfair's default old-style numerals dip and shrink at this size. */
	.value {
		color: var(--black);
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 2rem + 1.5vw, 3rem);
		font-variant-numeric: lining-nums;
		line-height: 1;
	}
	.label {
		margin-top: 0.75rem;
		color: var(--gray);
		font-size: 1rem;
	}

	/* Grows to the height of the breakdowns in its row. The left margin holds the axis numbers. */
	.timeline {
		display: flex;
		flex-direction: column;
	}
	.plot {
		position: relative;
		flex: 1;
		min-height: 11rem;
		margin: 1.5rem 0.5rem 0 1.5rem;
	}
	.tick {
		position: absolute;
		top: calc(var(--y) * 1%);
		right: 0;
		left: 0;
		border-top: 1px solid var(--gray-light);
		color: var(--gray);
		font-size: 0.875rem;
		line-height: 0;
		text-indent: -1.5rem;
		font-variant-numeric: tabular-nums;
	}
	.plot svg {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.area {
		fill: var(--accent);
		opacity: 0.1;
	}
	.line {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}
	/* Each point is a full-height 24px hover area, so the pointer only has to find the date.
	   Points get too dense to tap as posts add up, so the links live in the table below. */
	.point {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--x) * 1%);
		width: 1.5rem;
		margin-left: -0.75rem;
	}
	.point:hover {
		z-index: 1;
	}
	.point:hover::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1px;
		background: var(--gray);
	}
	.dot {
		position: absolute;
		top: calc(var(--y) * 1%);
		left: 50%;
		width: 0.5rem;
		height: 0.5rem;
		background: var(--accent);
		border-radius: 50%;
		box-shadow: 0 0 0 2px var(--paper);
		translate: -50% -50%;
	}
	/* Shifting by --x holds it inside the plot. */
	.tip {
		position: absolute;
		left: 50%;
		display: flex;
		flex-direction: column;
		width: 12rem;
		padding: 0.5rem 0.75rem;
		background: var(--black);
		color: var(--paper);
		font-size: 0.875rem;
		line-height: 1.4;
		opacity: 0;
		pointer-events: none;
		translate: calc(var(--x) * -1%) 0;
	}
	.below {
		top: calc(var(--y) * 1% + 0.75rem);
	}
	.above {
		bottom: calc((100 - var(--y)) * 1% + 0.75rem);
	}
	.point:hover .tip {
		opacity: 1;
	}
	.axis {
		display: flex;
		justify-content: space-between;
		margin: 0.5rem 0.5rem 0 1.5rem;
		color: var(--gray);
		font-size: 0.875rem;
	}
	details {
		margin-top: 0.5rem;
		font-size: 0.875rem;
	}
	summary {
		padding-block: 0.5rem;
		color: var(--accent);
		cursor: pointer;
	}
	table {
		margin-top: 0.5rem;
		border-collapse: collapse;
	}
	/* The whole row is the link. */
	tr {
		position: relative;
	}
	td a::before {
		content: '';
		position: absolute;
		inset: 0;
	}
	th,
	td {
		padding: 0.25rem 0.75rem 0.25rem 0;
		border-top: 1px solid var(--gray-light);
		font-weight: 400;
		text-align: left;
		vertical-align: top;
	}
	th {
		color: var(--gray);
	}
	td:first-child {
		white-space: nowrap;
	}
	td:last-child {
		padding-right: 0;
		font-variant-numeric: tabular-nums;
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	li {
		position: relative;
		font-size: 1rem;
	}
	/* The whole row is the link. */
	li a::before {
		content: '';
		position: absolute;
		inset: 0;
	}
	.meter {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		color: var(--gray);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
	}
	.bar {
		flex: 0 0 calc(var(--share) * (100% - 1.5rem));
		height: 0.5rem;
		background: var(--accent);
		border-radius: 0 4px 4px 0;
	}
	li:has(a:hover) .bar {
		background: var(--accent-dark);
	}

	@media (min-width: 40rem) {
		.stats {
			grid-template-columns: 1fr 1fr;
		}
		.timeline {
			grid-column: span 2;
		}
	}
	@media (min-width: 64rem) {
		.stats {
			grid-template-columns: repeat(4, 1fr);
		}
		.cell {
			--py: 1.5rem;
			--px: 1.5rem;
		}
	}
</style>
