---
import { AUTHOR } from '../consts';
import { CONFIDENCE_LEVELS, labelOf } from '../data/taxonomy';
import { getReadingMinutes, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { pubDate, updatedDate, confidence } = post.data;
---

<p class="byline">
	<span class="author">Bài viết của <a href="/gioi-thieu/" rel="author">{AUTHOR}</a></span>
	<span class="facts">
		<FormattedDate date={pubDate} />
		{updatedDate && <><span class="sep" aria-hidden="true">·</span>Cập nhật <FormattedDate date={updatedDate} /></>}
		<span class="sep" aria-hidden="true">·</span>{getReadingMinutes(post)} phút đọc
		{confidence && <><span class="sep" aria-hidden="true">·</span>{labelOf(CONFIDENCE_LEVELS, confidence)}</>}
	</span>
</p>
<style>
	.byline {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin: 0;
		padding-block: 0.875rem;
		border-block: 1px solid var(--border);
		color: var(--text-2);
		font-size: 0.875rem;
		line-height: 1.5;
	}
	.author {
		color: var(--text);
	}
	.author a {
		color: inherit;
		font-weight: 600;
	}
	.sep {
		margin-inline: 0.5em;
		color: var(--gold);
	}
</style>
