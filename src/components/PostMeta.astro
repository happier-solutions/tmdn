---
import { CATEGORIES, CONFIDENCE_LEVELS, labelOf } from '../data/taxonomy';
import { getReadingMinutes, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { pubDate, updatedDate, category, confidence } = post.data;
---

<div class="meta">
	<FormattedDate date={pubDate} />
	{updatedDate && <><span class="sep">{' · '}</span>{'Cập nhật '}<FormattedDate date={updatedDate} /></>}
	<span class="sep">{' · '}</span><a href={`/${category}/`}>{labelOf(CATEGORIES, category)}</a><span class="sep">{' · '}</span>{getReadingMinutes(post)} phút đọc
</div>
<p class="confidence">Mức độ chắc chắn: <strong>{labelOf(CONFIDENCE_LEVELS, confidence)}</strong></p>
<style>
	.meta,
	.confidence {
		margin: 0.5rem 0 0;
		color: var(--gray);
		font-size: 0.875rem;
	}
	/* The hover sprig takes the separator's place, so the text after it never moves.
	   The margin makes that place wide enough for the sprig. */
	.sep {
		margin-inline: 0.2em;
	}
	@media (hover: hover) {
		.meta a:hover + .sep {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.sep {
			transition: opacity 200ms ease-out;
		}
	}
</style>
