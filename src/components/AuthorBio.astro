---
import { AUTHOR, AUTHOR_BIO } from '../consts';
---

<section aria-labelledby="author-heading">
	<span class="seal" aria-hidden="true"></span>
	<div>
		<p class="label">Tác giả</p>
		<h2 id="author-heading">{AUTHOR}</h2>
	</div>
	<div class="about">
		<p class="bio">{AUTHOR_BIO}</p>
		<p class="more"><a href="/gioi-thieu/" rel="author">Về Tư Mã Đại Nhân</a></p>
	</div>
</section>
<style>
	/* The bio takes the full width on a phone, where the logo's column would squeeze it. */
	section {
		margin-top: 3rem;
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
	}
	.about {
		grid-column: 1 / -1;
	}
	/* The header's seal, larger. */
	.seal {
		width: 4rem;
		height: 4rem;
		background: var(--seal);
		mask:
			url('/sprig.svg') center / 2.75rem no-repeat exclude,
			linear-gradient(#000 0 0);
	}
	p {
		margin: 0;
		font-size: 0.875rem;
	}
	.label {
		color: var(--text-2);
	}
	h2 {
		margin: 0.25rem 0 0;
		font-size: 1.25rem;
	}
	.bio {
		font-size: 1rem;
	}
	.more {
		margin-top: 0.75rem;
	}
	@media (min-width: 40rem) {
		section {
			column-gap: 1.5rem;
			row-gap: 0.5rem;
		}
		.seal {
			grid-row: 1 / span 2;
			align-self: start;
		}
		.about {
			grid-column: 2;
		}
	}
</style>
