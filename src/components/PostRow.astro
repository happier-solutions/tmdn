---
import { getReadingMinutes, type Post, postUrl } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
import PostLabel from './PostLabel.astro';
import Thumb from './Thumb.astro';

interface Props {
	post: Post;
	/** Leaves out the pillar in the label, on a pillar's own pages. */
	topicOnly?: boolean;
	/** The heading level that fits the page's outline. */
	level?: 2 | 3;
}

const { post, topicOnly = false, level = 2 } = Astro.props;
const { title, description, pubDate } = post.data;
const Heading = `h${level}` as const;
---

{/* A list entry: text first, a small picture at the side. Separated by the list's rules, not a frame. */}
<article class="row">
	<div class="text">
		<PostLabel {post} {topicOnly} />
		<Heading class="title"><a href={postUrl(post)}>{title}</a></Heading>
		<p class="dek">{description}</p>
		<p class="meta"><FormattedDate date={pubDate} /> · {getReadingMinutes(post)} phút đọc</p>
	</div>
	<Thumb {post} class="row-thumb" sizes="(min-width: 40rem) 13rem, 5.5rem" widths={[176, 416, 624]} />
</article>
<style>
	.row {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 5.5rem;
		gap: 1rem;
		align-items: start;
	}
	.text {
		display: grid;
		gap: 0.375rem;
		min-width: 0;
	}
	.title {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.3;
	}
	.title a {
		color: inherit;
	}
	/* The title's link covers the row; the labels sit above it. */
	.title a::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}
	.title a:focus-visible {
		outline: none;
	}
	.row:has(.title a:focus-visible) {
		outline: 2px solid var(--bamboo);
		outline-offset: 0.5rem;
	}
	.dek {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		color: var(--text-2);
		font-size: 0.9375rem;
		line-height: 1.6;
		text-wrap: pretty;
	}
	.meta {
		margin: 0.25rem 0 0;
	}
	.row :global(.row-thumb) {
		aspect-ratio: 1;
	}
	@media (min-width: 40rem) {
		.row {
			grid-template-columns: minmax(0, 1fr) 13rem;
			gap: 2rem;
		}
		.title {
			font-size: 1.5rem;
		}
		.dek {
			font-size: 1rem;
		}
		.row :global(.row-thumb) {
			aspect-ratio: 4 / 3;
		}
	}
</style>
