---
import type { CategorySlug } from '../data/taxonomy';

interface Props {
	slug: CategorySlug;
	size?: number;
}

// Stroke paths on a 32x32 grid.
const paths: Record<CategorySlug, string> = {
	// An eye.
	'quan-sat': 'M3 16s5-8.5 13-8.5S29 16 29 16s-5 8.5-13 8.5S3 16 3 16Z M16 12a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
	// A question mark in a circle.
	'cau-hoi':
		'M16 3a13 13 0 1 0 0 26 13 13 0 0 0 0-26Z M12.3 12.6a3.8 3.8 0 1 1 5.9 3.2c-1.4.9-2.2 1.8-2.2 3.4 M16 23v.01',
	// A magnifying glass.
	'nghien-cuu': 'M14 4a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z M21.2 21.2 28 28',
	// An open book.
	'bai-hoc': 'M16 9c-3-2.4-7-3-12-3v19c5 0 9 .6 12 3 3-2.4 7-3 12-3V6c-5 0-9 .6-12 3Z M16 9v19',
	// A pen on a written line.
	'nhat-ky-hoc-tap': 'M5 27l1.6-6.4L21 6.2a2.8 2.8 0 0 1 4 0l.8.8a2.8 2.8 0 0 1 0 4L11.4 25.4 5 27Z M18.5 8.7l4.8 4.8 M16 28h11',
};

const { slug, size = 36 } = Astro.props;
---

<svg viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
	<path d={paths[slug]} />
</svg>
<style>
	svg {
		display: block;
		color: var(--accent);
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4px;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* The line keeps its weight at any size. */
	path {
		vector-effect: non-scaling-stroke;
	}
</style>
