---
import { Picture } from 'astro:assets';
import type { Post } from '../lib/posts';

interface Props {
	post: Post;
	sizes: string;
	widths: number[];
	eager?: boolean;
	class?: string;
}

const { post, sizes, widths, eager = false, class: className } = Astro.props;
const { heroImage } = post.data;
---

{/* The frame sets the crop; the image covers it. AVIF first: about half the bytes of WebP, which matters for the lead's LCP. Without a hero image it shows the sprig on a wash. */}
<div class:list={['thumb', className, { empty: !heroImage }]}>
	{heroImage && (
		<Picture
			src={heroImage}
			formats={['avif', 'webp']}
			alt=""
			{sizes}
			{widths}
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : undefined}
		/>
	)}
</div>
<style>
	.thumb {
		position: relative;
		overflow: clip;
		background: var(--wash);
	}
	img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.empty::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--gold);
		mask: url('/sprig.svg') center / min(3rem, 40%) no-repeat;
	}
	/* The painting drifts closer inside its frame when its card's title is hovered. */
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		img {
			transition: scale 500ms ease-out;
		}
		:global(article:has(.title a:hover)) img {
			scale: 1.03;
		}
	}
</style>
