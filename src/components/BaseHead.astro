---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/logo.png', type = 'website' } = Astro.props;

// Chỉ preload phần đủ cho văn bản tiếng Việt ở độ đậm thường.
const fontPreload = [
	{ weight: 400, subset: 'latin' as const },
	{ weight: 400, subset: 'vietnamese' as const },
];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" data-scheme="light" media="(prefers-color-scheme: light)" content="#f4efe6" />
<meta name="theme-color" data-scheme="dark" media="(prefers-color-scheme: dark)" content="#191713" />
<meta name="color-scheme" content="light dark" />
<!-- Inline and first, so a pinned scheme applies before the first paint. No stored value means system. -->
<script is:inline>
	window.readColorScheme = () => {
		try {
			const scheme = localStorage.getItem('color-scheme');
			return scheme === 'light' || scheme === 'dark' ? scheme : null;
		} catch {
			return null;
		}
	};
	window.applyColorScheme = (scheme) => {
		document.querySelector('meta[name="color-scheme"]').content = scheme ?? 'light dark';
		for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
			const own = meta.dataset.scheme;
			meta.media = scheme ? (scheme === own ? 'all' : 'not all') : `(prefers-color-scheme: ${own})`;
		}
	};
	applyColorScheme(readColorScheme());
</script>
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-body" preload={fontPreload} />
<Font cssVariable="--font-heading" preload={fontPreload} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hold the first paint until <main> is parsed so the page transition never reveals a blank page. -->
<link rel="expect" href="#main" blocking="render" />

<!-- Prefetch same-origin links on user intent; /admin/ is the CMS, not a reading page. Ignored by browsers without support. -->
<script is:inline type="speculationrules">
	{
		"prefetch": [
			{
				"where": {
					"and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/admin/*" } }]
				},
				"eagerness": "moderate"
			}
		]
	}
</script>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
