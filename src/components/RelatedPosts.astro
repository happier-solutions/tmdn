---
import type { Post } from '../lib/posts';
import PostTile from './PostTile.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
	<section aria-labelledby="related-heading">
		<h2 id="related-heading">Bài liên quan</h2>
		<ul>
			{posts.map((post) => (
				<li>
					<PostTile {post} />
				</li>
			))}
		</ul>
	</section>
)}
<style>
	section {
		margin-top: 3rem;
	}
	h2 {
		margin: 0 0 1.25rem;
		font-size: 1.25rem;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li + li {
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}
</style>
