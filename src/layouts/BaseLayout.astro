---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollTop from '../components/ScrollTop.astro';
import Signup from '../components/Signup.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	/** Widens `main` to the header's width, for a layout with side columns. */
	wide?: boolean;
}

const { title, description, image, type, wide } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={fullTitle} {description} {image} {type} />
	</head>
	<body>
		<a class="skip-link" href="#main">Bỏ qua, đến nội dung chính</a>
		<Header />
		<div class="first-screen">
			<main id="main" class:list={{ 'wrap-wide': wide }}>
				<slot />
			</main>
			<Signup />
		</div>
		<Footer />
		<ScrollTop />
	</body>
</html>
