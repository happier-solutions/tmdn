---
import type { Page } from 'astro';
import Pagination from '../components/Pagination.astro';
import PostRow from '../components/PostRow.astro';
import type { Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	/** Search snippet, longer than the visible `description`. */
	metaDescription: string;
	page: Page<Post>;
	/** A link above the title, to the section the list belongs to. */
	eyebrow?: { label: string; href: string };
	/** What the list covers, shown beside the title from 56rem. */
	points?: string[];
	/** Leaves out the pillar in each post's label, on a pillar's own pages. */
	topicOnly?: boolean;
}

const { title, description, metaDescription, page, eyebrow, points = [], topicOnly = false } = Astro.props;
const pageTitle = page.currentPage > 1 ? `${title} (trang ${page.currentPage})` : title;
const isFirstPage = page.currentPage === 1;
---

<BaseLayout
	title={pageTitle}
	description={isFirstPage ? metaDescription : `Trang ${page.currentPage}: ${metaDescription}`}
	wide
>
	<header class:list={['intro', { 'has-points': points.length > 0 }]}>
		<div class="heading">
			{eyebrow && <p class="kicker"><a href={eyebrow.href}>{eyebrow.label}</a></p>}
			<h1>{title}</h1>
			<p class="description">{description}</p>
			<p class="meta">{page.total} bài viết</p>
		</div>
		{points.length > 0 && (
			<div class="points">
				<p class="kicker">Bàn về</p>
				<ul>
					{points.map((point) => <li>{point}</li>)}
				</ul>
			</div>
		)}
	</header>
	{page.data.length ? (
		<ul class="posts">
			{page.data.map((post) => (
				<li><PostRow {post} {topicOnly} /></li>
			))}
		</ul>
	) : (
		<p class="empty">
			Chưa có bài viết nào ở đây. Bài đầu tiên đang được viết.
			{eyebrow && <> Trong lúc chờ, mời bạn ghé <a href={eyebrow.href}>{eyebrow.label}</a>.</>}
		</p>
	)}
	<Pagination {page} />
</BaseLayout>
<style>
	.intro {
		display: grid;
		gap: 2rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--text);
	}
	.heading {
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}
	.kicker a {
		color: inherit;
	}
	h1 {
		margin: 0;
	}
	.description {
		max-width: 38rem;
		margin: 0;
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-style: italic;
		line-height: 1.5;
		text-wrap: pretty;
	}
	.heading .meta {
		margin: 0;
	}
	.points ul {
		display: grid;
		gap: 0.375rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--text-2);
		font-size: 0.9375rem;
		line-height: 1.55;
	}
	/* A short rule in place of a bullet, like a margin note. */
	.points li {
		display: grid;
		grid-template-columns: 0.75rem minmax(0, 1fr);
		gap: 0.5rem;
	}
	.points li::before {
		content: '';
		height: 1px;
		margin-top: 0.8em;
		background: var(--gold);
	}

	.posts {
		max-width: 56rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.posts li {
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--border);
	}
	.empty {
		max-width: 38rem;
		padding-block: 2rem;
		color: var(--text-2);
	}
	@media (min-width: 56rem) {
		.intro.has-points {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			gap: 4rem;
		}
		.points {
			padding-left: 2rem;
			border-left: 1px solid var(--border);
		}
	}
</style>
