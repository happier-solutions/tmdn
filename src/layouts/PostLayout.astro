---
import type { MarkdownHeading } from 'astro';
import { getImage, Image } from 'astro:assets';
import PostMeta from '../components/PostMeta.astro';
import PrevNext from '../components/PrevNext.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ShareLinks from '../components/ShareLinks.astro';
import Toc from '../components/Toc.astro';
import UpdateNote from '../components/UpdateNote.astro';
import { labelOf, TAGS } from '../data/taxonomy';
import type { Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	related: Post[];
	newer?: Post;
	older?: Post;
}

const { post, headings, related, newer, older } = Astro.props;
const { title, description, heroImage, heroCredit, tags } = post.data;

const shareImage = heroImage
	? (await getImage({ src: heroImage, width: 1200, format: 'jpeg' })).src
	: undefined;

const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const hasToc = tocHeadings.length >= 3;
---

<BaseLayout {title} {description} image={shareImage} type="article" wide>
	<div class="post-grid">
		<article class="prose">
			{heroImage && (
				<figure class="hero">
					<Image class="hero-image" width={1020} height={510} src={heroImage} alt="" />
					{heroCredit && <figcaption>{heroCredit}</figcaption>}
				</figure>
			)}
			<header class="post-header">
				<h1>{title}</h1>
				<PostMeta {post} />
			</header>
			<UpdateNote {post} />
			{hasToc && (
				<details class="toc-inline">
					<summary>Mục lục</summary>
					<Toc headings={tocHeadings} />
				</details>
			)}
			<slot />
			{tags.length > 0 && (
				<ul class="tags" aria-label="Thẻ chủ đề">
					{tags.map((tag) => <li><a href={`/chu-de/${tag}/`}>#{labelOf(TAGS, tag)}</a></li>)}
				</ul>
			)}
		</article>
		<ShareLinks {title} />
		{hasToc && (
			<aside class="toc-rail">
				<p class="toc-title">Mục lục</p>
				<Toc headings={tocHeadings} />
			</aside>
		)}
		<RelatedPosts posts={related} />
		<PrevNext {newer} {older} />
	</div>
</BaseLayout>
<style>
	.post-grid {
		max-width: 42rem;
		margin-inline: auto;
	}
	.hero {
		margin: 0 0 2rem;
	}
	.hero-image {
		display: block;
		width: 100%;
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--gray);
		font-size: 0.875rem;
	}
	.post-header {
		margin-bottom: 2rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.875rem;
	}
	.toc-inline {
		margin-bottom: 2rem;
		border-block: 1px solid var(--gold);
	}
	summary {
		padding-block: 0.5rem;
		color: var(--gray-dark);
		font-size: 0.875rem;
		line-height: 1.75rem;
		cursor: pointer;
	}
	summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.toc-inline :global(.toc) {
		padding-bottom: 0.75rem;
	}
	.toc-rail {
		display: none;
	}
	.toc-title {
		margin: 0 0 0.5rem;
		color: var(--gray);
		font-size: 0.875rem;
		line-height: 1.5;
		font-weight: 700;
	}
	/* The middle column keeps the reading width of every other page. */
	@media (min-width: 64rem) {
		.post-grid {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 42rem) minmax(0, 1fr);
			column-gap: 2rem;
			max-width: none;
		}
		.post-grid > :global(*) {
			grid-column: 2;
		}
		.post-grid > :global(.share) {
			grid-area: 1 / 1;
		}
		.post-grid > article {
			grid-row: 1;
		}
		.post-grid > .toc-rail {
			display: block;
			position: sticky;
			top: 6rem;
			grid-area: 1 / 3;
			align-self: start;
			max-height: calc(100dvh - 7rem);
			overflow-y: auto;
		}
		.toc-inline {
			display: none;
		}
	}
</style>
