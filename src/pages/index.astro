---
import Feedback from '../components/Feedback.astro';
import HomeCategories from '../components/HomeCategories.astro';
import HomeStats from '../components/HomeStats.astro';
import PostCard from '../components/PostCard.astro';
import VisitThanks from '../components/VisitThanks.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

// Seven posts and the "all posts" cell make full rows at one, two and four columns.
const HOME_POSTS = 7;

const posts = await getPublishedPosts();
const latest = posts.slice(0, HOME_POSTS);
---

<BaseLayout description={SITE_DESCRIPTION} wide>
	<div class="home">
		<section class="ruled about" aria-labelledby="site-name">
			<div class="cell name">
				<h1 id="site-name">{SITE_TITLE}</h1>
			</div>
			<div class="cell">
				<p class="statement">
					Nhật ký công khai của một người đang học về lãnh đạo và quản trị: quan sát môi trường điều
					hành, đặt câu hỏi, tìm hiểu bản chất rồi rút ra bài học.
				</p>
			</div>
			<div class="cell text">
				<p>
					Viết cho chủ doanh nghiệp SME, quản lý trẻ và người sắp bước vào vị trí điều hành. Đây là
					ghi chép của người đang học, không phải lời khuyên của chuyên gia.
				</p>
				<a href="/gioi-thieu/"><span class="link-line">Đọc thêm về hành trình này</span></a>
			</div>
		</section>

		<section aria-labelledby="latest-heading">
			<div class="head">
				<h2 id="latest-heading">Bài viết mới nhất</h2>
			</div>
			{latest.length ? (
				<div class="ruled posts">
					{latest.map((post) => (
						<div class="cell post">
							<PostCard {post} imageSizes="(min-width: 64rem) 18rem, (min-width: 40rem) 50vw, 100vw" />
						</div>
					))}
					<div class="cell linked">
						<p class="all"><a href="/bai-viet/">Xem tất cả bài viết</a></p>
						<p class="count">{posts.length} bài</p>
					</div>
				</div>
			) : (
				<p>Chưa có bài viết.</p>
			)}
		</section>

		<section aria-labelledby="categories-heading">
			<div class="head">
				<h2 id="categories-heading">Danh mục</h2>
				<p>Năm chặng, từ điều tôi thấy đến điều tôi rút ra được.</p>
			</div>
			<HomeCategories {posts} />
		</section>

		{posts.length > 0 && (
			<section aria-labelledby="stats-heading">
				<div class="head">
					<h2 id="stats-heading">Thống kê</h2>
					<p>Tính từ các bài đã đăng, tự cập nhật mỗi khi có bài mới.</p>
				</div>
				<HomeStats {posts} />
			</section>
		)}

		<section aria-labelledby="feedback-heading">
			<VisitThanks>
				<div class="head">
					<h2 id="feedback-heading">Đánh giá và góp ý</h2>
					<p>Chỗ nào chưa ổn, mong bạn nói thẳng.</p>
				</div>
				<Feedback />
			</VisitThanks>
		</section>
	</div>
</BaseLayout>
<style>
	.home {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}
	h2 {
		margin: 0;
		font-size: 2rem;
	}
	p {
		margin: 0;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 2rem;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
		font-size: 1rem;
	}
	.head p {
		color: var(--gray);
		font-size: 1rem;
	}

	/* 6.95em is the set width of the name in Playfair Display at this tracking. */
	.name {
		container-type: inline-size;
		padding-block: 1rem;
	}
	h1 {
		margin: 0;
		font-size: calc(100cqi / 6.95);
		letter-spacing: -0.02em;
		line-height: 1.2;
		white-space: nowrap;
	}
	.statement {
		color: var(--black);
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
		line-height: 1.35;
		text-wrap: pretty;
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: start;
		font-size: 1rem;
	}
	.text a {
		margin-top: auto;
	}

	/* The card's link covers the whole cell, and its image bleeds to the cell's rules. */
	.post {
		position: relative;
		display: flex;
	}
	.post :global(article) {
		position: static;
		flex: 1;
		min-width: 0;
	}
	.post :global(.thumb) {
		margin: calc(-1 * var(--py)) calc(-1 * var(--px)) 1rem;
	}
	.post :global(p) {
		font-size: 1rem;
	}

	.linked .all {
		font-family: var(--font-heading);
		font-size: 1.25rem;
	}

	@media (min-width: 40rem) {
		.name {
			padding-block: 1.5rem;
			grid-column: 1 / -1;
		}
		.about {
			grid-template-columns: 3fr 2fr;
		}
		.posts {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (min-width: 64rem) {
		.posts {
			grid-template-columns: repeat(4, 1fr);
		}
		.posts .cell {
			--py: 1.5rem;
			--px: 1.5rem;
		}
		.post :global(h2) {
			font-size: 1.25rem;
		}
	}
</style>
