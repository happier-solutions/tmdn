---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import PostCard from '../components/PostCard.astro';
import PostLead from '../components/PostLead.astro';
import PostRow from '../components/PostRow.astro';
import { AUTHOR, AUTHOR_BIO, SITE_DESCRIPTION, SITE_MOTTO, SITE_NAME } from '../consts';
import { PILLARS, topicsOf, topicUrl } from '../data/taxonomy';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, topicOf } from '../lib/posts';

const LATEST = 5;
const SELECTED = 3;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/pillars/*.jpg', { eager: true });
const imageOf = (slug: string) => images[`../assets/pillars/${slug}.jpg`]?.default;

const posts = await getPublishedPosts();
// The newest featured post leads; without one, the newest post does.
const lead = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post !== lead).slice(0, LATEST);
const selected = posts
	.filter((post) => post.data.featured && post !== lead && !latest.includes(post))
	.slice(0, SELECTED);
const countIn = (pillar: string) => posts.filter((post) => topicOf(post).pillar === pillar).length;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_NAME,
	alternateName: AUTHOR,
	description: SITE_DESCRIPTION,
	inLanguage: 'vi',
	url: Astro.site?.href,
};
---

<BaseLayout description={SITE_DESCRIPTION} wide {jsonLd}>
	<section class="statement" aria-labelledby="site-name">
		<p class="dateline">
			<time id="today" hidden></time>
			{/* Static pages can't know today's date, so the visitor's clock sets it before first paint. */}
			<script is:inline>
				(() => {
					const now = new Date();
					const el = document.getElementById('today');
					const pad = (n) => String(n).padStart(2, '0');
					el.dateTime = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
					const weekday = new Intl.DateTimeFormat('vi-VN', { weekday: 'long' }).format(now);
					el.textContent = `${weekday}, ${now.getDate()} tháng ${now.getMonth() + 1}, ${now.getFullYear()}`;
					el.hidden = false;
				})();
			</script>
			<span>Ghi chép · Nghiên cứu · Chiêm nghiệm</span>
		</p>
		<h1 id="site-name">
			<span class="kicker">{SITE_NAME}</span>
			<span class="tagline">Tu thân – Dưỡng chí – Lập nghiệp.</span>
		</h1>
		<div class="statement-body">
			<p class="motto">{SITE_MOTTO}</p>
			<div class="about">
				<p>
					Không gian ghi chép, nghiên cứu và chia sẻ những suy ngẫm về con người, tri thức, tư duy, lịch
					sử, xã hội, lãnh đạo và quản trị doanh nghiệp. Để bồi dưỡng nội lực, mở rộng nhận thức và phát
					triển năng lực lập nghiệp.
				</p>
				<a href="/gioi-thieu/"><span class="link-line">Về Trúc Chí Lập Thân</span></a>
			</div>
		</div>
	</section>

	{lead && (
		<section class="block" aria-label="Bài nổi bật">
			<PostLead post={lead} eyebrow={lead.data.featured ? 'Bài nổi bật' : 'Bài mới nhất'} eager />
		</section>
	)}

	{latest.length > 0 && (
		<section class="block split" aria-labelledby="latest-heading">
			<div class="side">
				<h2 id="latest-heading" class="section-title">Bài viết mới</h2>
				<p class="side-note">Những ghi chép gần đây nhất, từ cả hai chuyên mục.</p>
				<a href="/bai-viet/"><span class="link-line">Tất cả bài viết</span></a>
			</div>
			<ul class="rows">
				{latest.map((post) => <li><PostRow {post} level={3} /></li>)}
			</ul>
		</section>
	)}

	<section class="block" aria-labelledby="pillars-heading">
		<h2 id="pillars-heading" class="section-title">Hai chuyên mục</h2>
		<div class="pillars">
			{PILLARS.map((pillar, index) => {
				const topics = topicsOf(pillar.slug);
				const image = imageOf(pillar.slug);
				const count = countIn(pillar.slug);
				return (
					<article class="pillar">
						{image && <Picture src={image} formats={['avif', 'webp']} widths={[400, 640, 960]} sizes="(min-width: 56rem) 34rem, 100vw" alt="" />}
						<p class="kicker">Chuyên mục {String(index + 1).padStart(2, '0')}</p>
						<h3><a href={`/${pillar.slug}/`}>{pillar.label}</a></h3>
						<p class="pillar-motto">{pillar.description}</p>
						<ul class="topic-list" aria-label={`Chủ đề của ${pillar.label}`}>
							{topics.map((topic) => <li><a href={topicUrl(topic)}>{topic.label}</a></li>)}
						</ul>
						<p class="meta">{topics.length} chủ đề · {count ? `${count} bài viết` : 'sắp có bài'}</p>
					</article>
				);
			})}
		</div>
	</section>

	{selected.length > 0 && (
		<section class="block" aria-labelledby="selected-heading">
			<h2 id="selected-heading" class="section-title">Bài chọn lọc</h2>
			<ul class="cards">
				{selected.map((post, i) => <li><PostCard {post} number={i + 1} /></li>)}
			</ul>
		</section>
	)}

	<section class="block author" aria-labelledby="author-heading">
		<span class="seal" aria-hidden="true"></span>
		<div class="author-text">
			<p class="kicker">Lời người viết</p>
			<h2 id="author-heading">{AUTHOR}</h2>
			<p>{AUTHOR_BIO}</p>
			<a href="/gioi-thieu/" rel="author"><span class="link-line">Đọc lời tự răn</span></a>
		</div>
		<blockquote class="maxim">
			<p>Cứ bền bỉ mà học, điềm đạm mà làm.<br />Rễ sâu thì trúc tự vươn cao.</p>
		</blockquote>
	</section>
</BaseLayout>
<style>
	.statement {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--text);
	}
	.dateline {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		justify-content: space-between;
		margin: 0 0 2rem;
		padding-block: 0.5rem;
		border-block: 1px solid var(--border);
		color: var(--text-2);
		font-size: 0.8125rem;
		line-height: 1.5;
	}
	.dateline time:first-letter {
		text-transform: uppercase;
	}
	h1 {
		display: grid;
		gap: 0.75rem;
		margin: 0;
	}
	.tagline {
		display: block;
		font-size: clamp(2.375rem, 1.5rem + 4vw, 5rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.statement-body {
		display: grid;
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.motto {
		margin: 0;
		color: var(--text);
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 1.0625rem + 0.75vw, 1.625rem);
		font-style: italic;
		line-height: 1.45;
		text-wrap: balance;
	}
	.about p {
		margin: 0 0 0.75rem;
		color: var(--text-2);
		font-size: 1rem;
		line-height: 1.75;
	}
	@media (min-width: 56rem) {
		.statement-body {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			gap: 4rem;
		}
	}

	.block {
		margin-top: 3rem;
	}
	/* Each block after the lead opens on a full-strength rule, like a magazine's section break. */
	.block + .block {
		padding-top: 2.5rem;
		border-top: 1px solid var(--text);
	}
	.section-title {
		margin: 0 0 1.5rem;
		font-size: 1.75rem;
	}

	/* Asymmetric: a narrow column names the block, the wide one holds the list. */
	.split {
		display: grid;
		gap: 1rem;
	}
	.side-note {
		margin: 0 0 0.75rem;
		color: var(--text-2);
		font-size: 0.9375rem;
	}
	.side .section-title {
		margin-bottom: 0.5rem;
	}
	.rows {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.rows li {
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.rows li:first-child {
		padding-top: 0;
	}
	@media (min-width: 56rem) {
		.split {
			grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
			gap: 4rem;
		}
		.side {
			position: sticky;
			top: 6rem;
			align-self: start;
		}
	}

	.pillars {
		display: grid;
		gap: 3rem;
	}
	.pillar {
		position: relative;
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}
	.pillar :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		margin-bottom: 0.5rem;
	}
	.pillar h3 {
		margin: 0;
		font-size: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
		font-weight: 400;
	}
	.pillar h3 a {
		color: inherit;
	}
	.pillar-motto {
		margin: 0;
		font-family: var(--font-heading);
		font-size: 1.1875rem;
		font-style: italic;
		line-height: 1.5;
		text-wrap: pretty;
	}
	.topic-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.25rem;
		margin: 0.25rem 0 0;
		padding: 0.75rem 0 0;
		border-top: 1px solid var(--border);
		list-style: none;
		font-size: 0.875rem;
		line-height: 1.9;
	}
	/* A middle dot between topics; the sprig on hover stays clear of it. */
	.topic-list li:not(:last-child)::after {
		content: '·';
		margin-left: 0.75rem;
		margin-right: 0.25rem;
		color: var(--gold);
	}
	.pillar .meta {
		margin: 0;
	}
	@media (min-width: 56rem) {
		.pillars {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 4rem;
		}
		/* The second pillar sits lower: two columns, not a matched pair of cards. */
		.pillar:nth-child(2) {
			margin-top: 4rem;
		}
	}

	.cards {
		display: grid;
		gap: 2.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 40rem) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 64rem) {
		.cards {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.author {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}
	.seal {
		width: 4rem;
		height: 4rem;
		background: var(--seal);
		mask:
			url('/sprig.svg') center / 2.75rem no-repeat exclude,
			linear-gradient(#000 0 0);
	}
	.author-text h2 {
		margin: 0.25rem 0 0.75rem;
		font-size: 1.75rem;
	}
	.author-text p:not(.kicker) {
		max-width: 36rem;
		color: var(--text-2);
		font-size: 1rem;
		line-height: 1.75;
	}
	.maxim {
		grid-column: 1 / -1;
		margin: 0;
		padding: 1.25rem 0 0;
		border: 0;
		border-top: 1px solid var(--border);
		font-family: var(--font-heading);
		font-size: clamp(1.375rem, 1.125rem + 1vw, 1.875rem);
		font-style: italic;
		line-height: 1.4;
	}
	.maxim p {
		margin: 0;
	}
	@media (min-width: 56rem) {
		.author {
			grid-template-columns: 4rem minmax(0, 6fr) minmax(0, 5fr);
			gap: 2rem;
		}
		.maxim {
			grid-column: 3;
			align-self: center;
			padding: 0 0 0 2rem;
			border-top: 0;
			border-left: 1px solid var(--border);
		}
	}
</style>
