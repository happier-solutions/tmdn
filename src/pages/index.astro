---
import Feedback from '../components/Feedback.astro';
import HomeCategories from '../components/HomeCategories.astro';
import HomeStats from '../components/HomeStats.astro';
import PostCard from '../components/PostCard.astro';
import VisitThanks from '../components/VisitThanks.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

// Seven posts and the "all posts" cell make full rows at one, two and four columns.
const HOME_POSTS = 7;
// The first row at four columns, which also covers what a phone shows first.
const EAGER_POSTS = 4;

const posts = await getPublishedPosts();
const latest = posts.slice(0, HOME_POSTS);
---

<BaseLayout description={SITE_DESCRIPTION} wide>
	<div class="home">
		<section aria-labelledby="site-name">
			<h1 id="site-name" class="sr-only">{SITE_TITLE}</h1>
			<div class="today">
				<time id="today" hidden></time>
				{/* Static pages can't know today's date, so the visitor's clock sets it before first paint. */}
				<script is:inline>
					(() => {
						const now = new Date();
						const el = document.getElementById('today');
						const pad = (n) => String(n).padStart(2, '0');
						el.dateTime = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
						// Built by hand: Safari's vi-VN long date adds "ngày", which overflows the size set below.
						const weekday = new Intl.DateTimeFormat('vi-VN', { weekday: 'long' }).format(now);
						el.textContent = `${weekday}, ${now.getDate()} tháng ${now.getMonth() + 1}, ${now.getFullYear()}`;
						el.hidden = false;
					})();
				</script>
			</div>
			<div class="ruled about">
				<div class="cell">
					<p class="statement">
						Nhật ký công khai của một người đang học về lãnh đạo và quản trị: quan sát môi trường điều
						hành, đặt câu hỏi, tìm hiểu bản chất rồi rút ra bài học.
					</p>
				</div>
				<div class="cell text">
					<p>
						Viết cho chủ doanh nghiệp SME, quản lý trẻ và người sắp bước vào vị trí điều hành. Đây là
						ghi chép của người đang học, không phải lời khuyên của chuyên gia.
					</p>
					<a href="/gioi-thieu/"><span class="link-line">Đọc thêm về hành trình này</span></a>
				</div>
			</div>
		</section>

		<section aria-labelledby="latest-heading">
			<div class="head">
				<h2 id="latest-heading">Bài viết mới nhất</h2>
			</div>
			{latest.length ? (
				<div class="ruled posts">
					{latest.map((post, i) => (
						<div class="cell post">
							<PostCard {post} eager={i < EAGER_POSTS} imageSizes="(min-width: 64rem) 18rem, (min-width: 40rem) 50vw, 40vw" />
						</div>
					))}
					<div class="cell linked">
						<p class="all"><a href="/bai-viet/">Xem tất cả bài viết</a></p>
						<p class="count">{posts.length} bài</p>
					</div>
				</div>
			) : (
				<p>Chưa có bài viết.</p>
			)}
		</section>

		<section aria-labelledby="categories-heading">
			<div class="head">
				<h2 id="categories-heading">Danh mục</h2>
				<p>Năm chặng, từ điều tôi thấy đến điều tôi rút ra được.</p>
			</div>
			<HomeCategories {posts} />
		</section>

		{posts.length > 0 && (
			<section aria-labelledby="stats-heading">
				<div class="head">
					<h2 id="stats-heading">Thống kê</h2>
					<p>Tính từ các bài đã đăng, tự cập nhật mỗi khi có bài mới.</p>
				</div>
				<HomeStats {posts} />
			</section>
		)}

		<section aria-labelledby="feedback-heading">
			<VisitThanks>
				<div class="head">
					<h2 id="feedback-heading">Đánh giá và góp ý</h2>
					<p>Chỗ nào chưa ổn, mong bạn nói thẳng.</p>
				</div>
				<Feedback />
			</VisitThanks>
		</section>
	</div>
</BaseLayout>
<style>
	.home {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}
	h2 {
		margin: 0;
		font-size: 1.5rem;
	}
	p {
		margin: 0;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 2rem;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1rem;
		font-size: 1rem;
	}
	.head p {
		color: var(--gray);
		font-size: 0.875rem;
	}

	/* The longest date ("Chủ Nhật, 29 tháng 10, 2028") is 11.93em in Playfair Display at this tracking, so 13em leaves a margin. */
	.today {
		container-type: inline-size;
		padding-bottom: 1rem;
	}
	time {
		color: var(--black);
		font-family: var(--font-heading);
		font-size: min(100cqi / 13, 5rem);
		font-variant-numeric: lining-nums;
		letter-spacing: -0.02em;
		line-height: 1.2;
		white-space: nowrap;
	}
	.about > .cell {
		background: var(--gray-light);
	}
	.statement {
		color: var(--black);
		font-family: var(--font-heading);
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
		line-height: 1.4;
		text-wrap: pretty;
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-items: start;
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.text a {
		margin-top: auto;
	}

	/* The card's link covers the whole cell. */
	.post {
		position: relative;
		display: flex;
	}
	.post :global(article) {
		position: static;
		flex: 1;
		min-width: 0;
	}
	.post :global(h2) {
		font-size: 1.25rem;
	}
	.post :global(p) {
		font-size: 1rem;
		line-height: 1.5;
		text-wrap: pretty;
	}

	.linked .all {
		font-family: var(--font-heading);
		font-size: 1.25rem;
	}

	/* Phones: whitespace alone splits the posts, with no frame or rules.
	   `.ruled.posts` and the longer selectors outrank `ruled.css` whatever the order of the two sheets. */
	@media (width < 40rem) {
		.ruled.posts {
			gap: 1.5rem;
			overflow: visible;
			border: 0;
		}
		.posts .cell {
			margin: 0;
			padding: 0;
			border: 0;
		}
		.posts .linked .count {
			padding-top: 0;
		}
		.posts .linked:has(a:hover) {
			background: none;
		}
		.posts .linked:has(a:focus-visible) {
			outline-offset: 2px;
		}
	}

	@media (min-width: 40rem) {
		.home {
			gap: 3rem;
		}
		.about {
			grid-template-columns: 3fr 2fr;
		}
		.posts {
			grid-template-columns: 1fr 1fr;
		}
		.posts .cell {
			--py: 1.5rem;
			--px: 1.5rem;
		}
		/* From here the image sits above the text and bleeds to the cell's rules. */
		.post :global(.thumb) {
			margin: calc(-1 * var(--py)) calc(-1 * var(--px)) 1rem;
		}
	}
	@media (min-width: 64rem) {
		.about .cell {
			--py: 1.5rem;
			--px: 1.5rem;
		}
		.posts {
			grid-template-columns: repeat(4, 1fr);
		}
		.posts .cell {
			--py: 1.25rem;
			--px: 1.25rem;
		}
	}
	/* The small sizes suit both a phone's single column and the four narrow columns. */
	@media (width < 40rem), (min-width: 64rem) {
		.post :global(h2),
		.linked .all {
			font-size: 1.125rem;
		}
		.post :global(p) {
			font-size: 0.875rem;
		}
		.post :global(.meta),
		.linked .count {
			font-size: 0.75rem;
		}
	}
</style>
