---
import type { GetStaticPaths } from 'astro';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import PostLead from '../../components/PostLead.astro';
import PostRow from '../../components/PostRow.astro';
import { type Pillar, PILLARS, topicsOf, topicUrl } from '../../data/taxonomy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, type Post, topicOf } from '../../lib/posts';

// Each pillar's picture is `src/assets/pillars/<slug>.jpg`, portrait 4:5.
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/pillars/*.jpg', { eager: true });
const imageOf = (slug: string) => images[`../../assets/pillars/${slug}.jpg`]?.default;

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();
	return PILLARS.map((pillar, index) => ({
		params: { pillar: pillar.slug },
		props: { pillar, index, posts: posts.filter((post) => topicOf(post).pillar === pillar.slug) },
	}));
}) satisfies GetStaticPaths;

type Props = { pillar: Pillar; index: number; posts: Post[] };

const { pillar, index, posts } = Astro.props;
const topics = topicsOf(pillar.slug);
const image = imageOf(pillar.slug);
const lead = posts.find((post) => post.data.featured);
const countOf = (topic: string) => posts.filter((post) => post.data.topic === topic).length;

// Search ignores case and Vietnamese marks, so "quan tri" finds "Quản trị".
const fold = (text: string) =>
	text.normalize('NFD').replace(/\p{Mn}/gu, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();
---

<BaseLayout title={pillar.label} description={pillar.metaDescription} wide>
	<header class:list={['masthead', { mirrored: index % 2 === 1 }]}>
		<div class="text">
			<p class="kicker">Chuyên mục {String(index + 1).padStart(2, '0')}</p>
			<h1>{pillar.label}</h1>
			<p class="motto">{pillar.description}</p>
			<p class="intro">{pillar.intro}</p>
			<p class="meta">{topics.length} chủ đề · {posts.length} bài viết</p>
		</div>
		{image && (
			<figure>
				<Picture
					src={image}
					formats={['avif', 'webp']}
					widths={[400, 640, 960]}
					sizes="(min-width: 56rem) 26rem, 100vw"
					loading="eager"
					fetchpriority="high"
					alt=""
				/>
				{pillar.imageCaption && <figcaption>{pillar.imageCaption}</figcaption>}
			</figure>
		)}
	</header>

	<section class="topics" aria-labelledby="topics-heading">
		<h2 id="topics-heading" class="section-title">Các chủ đề</h2>
		<ol>
			{topics.map((topic, i) => (
				<li>
					<span class="number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
					<h3><a href={topicUrl(topic)}>{topic.label}</a></h3>
					<p>{topic.description}</p>
					<p class="meta">{countOf(topic.slug) ? `${countOf(topic.slug)} bài` : 'Sắp có bài'}</p>
				</li>
			))}
		</ol>
	</section>

	{lead && (
		<section class="featured" aria-labelledby="featured-heading">
			<h2 id="featured-heading" class="section-title">Bài nổi bật</h2>
			<PostLead post={lead} topicOnly level={3} />
		</section>
	)}

	<section class="latest" aria-labelledby="latest-heading">
		<div class="latest-head">
			<h2 id="latest-heading" class="section-title">Bài viết mới nhất</h2>
			{posts.length > 0 && (
				<form class="filter" role="search" aria-label={`Tìm trong ${pillar.label}`}>
					<label class="sr-only" for="filter-text">Tìm bài viết</label>
					<input id="filter-text" type="search" name="q" placeholder="Tìm bài viết…" autocomplete="off" enterkeyhint="search" />
					<label class="sr-only" for="filter-topic">Chủ đề</label>
					<select id="filter-topic" name="topic">
						<option value="">Mọi chủ đề</option>
						{topics.map((topic) => <option value={topic.slug} disabled={!countOf(topic.slug)}>{topic.label}</option>)}
					</select>
				</form>
			)}
		</div>
		{posts.length ? (
			<>
				<ul class="posts">
					{posts.map((post) => (
						<li data-topic={post.data.topic} data-text={fold(`${post.data.title} ${post.data.description} ${topicOf(post).label}`)}>
							<PostRow {post} topicOnly level={3} />
						</li>
					))}
				</ul>
				<p class="status" role="status" aria-live="polite"></p>
			</>
		) : (
			<p class="empty">Chuyên mục đang chuẩn bị những bài đầu tiên.</p>
		)}
	</section>
</BaseLayout>
<script>
	const form = document.querySelector<HTMLFormElement>('.filter');
	const items = [...document.querySelectorAll<HTMLLIElement>('.latest .posts > li')];
	const status = document.querySelector<HTMLElement>('.latest .status');
	const fold = (text: string) =>
		text.normalize('NFD').replace(/\p{Mn}/gu, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().trim();

	if (form && status) {
		const apply = () => {
			const data = new FormData(form);
			const words = fold(String(data.get('q') ?? '')).split(/\s+/).filter(Boolean);
			const topic = String(data.get('topic') ?? '');
			let shown = 0;
			for (const item of items) {
				const match =
					(!topic || item.dataset.topic === topic) && words.every((word) => item.dataset.text?.includes(word));
				item.hidden = !match;
				if (match) shown++;
			}
			const filtering = words.length > 0 || topic !== '';
			status.textContent = !filtering ? '' : shown ? `${shown} bài phù hợp.` : 'Không có bài phù hợp. Thử từ khác hoặc chọn mọi chủ đề.';
		};
		form.addEventListener('input', apply);
		form.addEventListener('submit', (event) => event.preventDefault());
	}
</script>
<style>
	.masthead {
		display: grid;
		gap: 2rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--text);
	}
	.text {
		display: grid;
		gap: 1rem;
		align-content: center;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 1.75rem + 3.5vw, 4.5rem);
		line-height: 1.1;
	}
	.motto {
		margin: 0;
		color: var(--text);
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 1.0625rem + 0.75vw, 1.625rem);
		font-style: italic;
		line-height: 1.45;
		text-wrap: pretty;
	}
	.intro {
		max-width: 36rem;
		margin: 0;
		color: var(--text-2);
		line-height: 1.75;
		text-wrap: pretty;
	}
	.text .meta {
		margin: 0;
		padding-top: 0.5rem;
		border-top: 1px solid var(--border);
	}
	figure {
		margin: 0;
	}
	figure :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--text-2);
		font-size: 0.8125rem;
		line-height: 1.5;
	}
	@media (width < 56rem) {
		figure :global(img) {
			aspect-ratio: 3 / 2;
		}
	}
	@media (min-width: 56rem) {
		.masthead {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			gap: 4rem;
		}
		/* The second pillar sets its picture first, so the two pages are related but not the same. */
		.mirrored {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		}
		.mirrored figure {
			order: -1;
		}
	}

	section {
		margin-top: 3.5rem;
	}
	.section-title {
		margin: 0 0 1.5rem;
		font-size: 1.75rem;
	}

	.topics ol {
		display: grid;
		gap: 0 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.topics li {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		column-gap: 0.75rem;
		align-content: start;
		padding-block: 1.25rem;
		border-top: 1px solid var(--border);
	}
	.topics li > :not(.number) {
		grid-column: 2;
	}
	.number {
		grid-row: 1 / span 3;
		color: var(--gold);
		font-family: var(--font-heading);
		font-size: 1.75rem;
		font-variant-numeric: lining-nums;
		line-height: 1;
	}
	.topics h3 {
		margin: 0 0 0.25rem;
		font-size: 1.25rem;
	}
	.topics h3 a {
		color: inherit;
	}
	/* The title's link covers the entry. */
	.topics h3 a::before {
		content: '';
		position: absolute;
		inset: 0;
	}
	.topics li:has(a:hover) .number {
		color: var(--bamboo);
	}
	.topics p {
		margin: 0;
		color: var(--text-2);
		font-size: 0.9375rem;
		line-height: 1.55;
	}
	.topics .meta {
		margin-top: 0.5rem;
	}
	@media (min-width: 40rem) {
		.topics ol {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 64rem) {
		.topics ol {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.featured {
		padding-top: 2.5rem;
		border-top: 1px solid var(--text);
	}

	.latest {
		padding-top: 2.5rem;
		border-top: 1px solid var(--text);
	}
	.latest-head {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	.latest-head .section-title {
		margin: 0;
	}
	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.filter :is(input, select) {
		box-sizing: border-box;
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--text-2);
		border-radius: 0;
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: 0.9375rem;
	}
	.filter input {
		flex: 1 1 14rem;
	}
	.filter select {
		flex: 1 1 12rem;
		max-width: 100%;
	}
	.filter :is(input, select):focus-visible {
		outline: 2px solid var(--bamboo);
		outline-offset: 1px;
	}
	/* Filtering needs JS, so without it the full list shows alone. */
	@media (scripting: none) {
		.filter {
			display: none;
		}
	}
	.posts {
		max-width: 56rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.posts li {
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--border);
	}
	.status:empty {
		display: none;
	}
	.status,
	.empty {
		margin: 1.5rem 0 0;
		color: var(--text-2);
	}
</style>
