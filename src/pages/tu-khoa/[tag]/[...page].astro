---
import type { GetStaticPaths, Page } from 'astro';
import { PAGE_SIZE } from '../../../consts';
import { type Tag, TAGS } from '../../../data/taxonomy';
import ListLayout from '../../../layouts/ListLayout.astro';
import { getPublishedPosts, type Post } from '../../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPublishedPosts();
	return TAGS.flatMap((tag) => {
		const tagged = posts.filter((post) => post.data.tags.includes(tag.slug));
		return paginate(tagged, {
			params: { tag: tag.slug },
			props: { tag },
			pageSize: PAGE_SIZE,
		});
	});
}) satisfies GetStaticPaths;

type Props = { page: Page<Post>; tag: Tag };

const { page, tag } = Astro.props;
---

<ListLayout
	title={`#${tag.label}`}
	description={`Các bài viết gắn từ khóa “${tag.label}”.`}
	metaDescription={`Các bài viết về ${tag.label.toLowerCase()} trên Trúc Chí Lập Thân, ghi chép của Tư Mã Đại Nhân về tri thức, lãnh đạo và quản trị.`}
	eyebrow={{ label: 'Từ khóa', href: '/tu-khoa/' }}
	{page}
/>
