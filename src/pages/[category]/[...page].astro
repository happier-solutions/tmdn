---
import type { GetStaticPaths, Page } from 'astro';
import { PAGE_SIZE } from '../../consts';
import { CATEGORIES } from '../../data/taxonomy';
import ListLayout from '../../layouts/ListLayout.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPublishedPosts();
	return CATEGORIES.flatMap((category) => {
		const inCategory = posts.filter((post) => post.data.category === category.slug);
		return paginate(inCategory, {
			params: { category: category.slug },
			props: { category, newest: inCategory[0]?.data.pubDate },
			pageSize: PAGE_SIZE,
		});
	});
}) satisfies GetStaticPaths;

type Props = { page: Page<Post>; category: (typeof CATEGORIES)[number]; newest?: Date };

const { page, category, newest } = Astro.props;
---

<ListLayout title={category.label} description={category.description} category={category.slug} {newest} {page} />
