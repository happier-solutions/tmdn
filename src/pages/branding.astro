---
// Internal brand guide: logo, colors and type. Not linked anywhere, noindex, out of the sitemap.
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, SITE_MOTTO, SITE_NAME, SITE_TAGLINE } from '../consts';

type Swatch = {
	name: string;
	token: string;
	light: string;
	dark?: string;
	use: string;
	/** Contrast on the page background (light / dark), or on `--ink` for the fixed tones. */
	contrast: string;
};

const palette: { title: string; note: string; swatches: Swatch[] }[] = [
	{
		title: 'Giấy',
		note: 'Nền ấm như giấy dó cũ, chiếm phần lớn bề mặt. Chỉ khác nhau một bậc, đủ để tách lớp mà không cần bóng hay khung.',
		swatches: [
			{ name: 'Giấy', token: '--bg', light: '#f5f2ea', dark: '#171814', use: 'Nền trang, header, ngăn kéo menu', contrast: 'Nền' },
			{ name: 'Giấy trắng', token: '--surface', light: '#faf9f5', dark: '#1f201b', use: 'Ô nhập liệu', contrast: 'Nền' },
			{ name: 'Giấy loang', token: '--wash', light: '#ede9df', dark: '#25261f', use: 'Ô ảnh chờ, code, ghi chú, panel menu con', contrast: 'Nền' },
			{ name: 'Đường kẻ', token: '--border', light: '#dcd8ce', dark: '#36372f', use: 'Đường kẻ mảnh 1px, viền nút tròn', contrast: '1.27 / 1.48, không dùng cho chữ' },
		],
	},
	{
		title: 'Mực',
		note: 'Mực đen ngả lục, không dùng đen tuyền. Dải chân trang luôn tối ở cả hai chế độ.',
		swatches: [
			{ name: 'Mực', token: '--text', light: '#242720', dark: '#e6e3da', use: 'Tiêu đề, chữ thân bài, đường kẻ mở phần', contrast: '13.54 / 13.90' },
			{ name: 'Mực nhạt', token: '--text-2', light: '#6b6a63', dark: '#a6a49b', use: 'Chữ phụ, ngày tháng, metadata', contrast: '4.85 / 7.14' },
			{ name: 'Mực tàu', token: '--ink', light: '#1e201b', use: 'Nền chân trang, dải đăng ký, toast', contrast: 'Nền tối cố định' },
			{ name: 'Giấy trên mực', token: '--on-ink', light: '#f5f2ea', use: 'Chữ trên nền --ink', contrast: '14.69 trên --ink' },
		],
	},
	{
		title: 'Trúc',
		note: 'Màu nhận diện chính. Mọi thứ có thể bấm hay dẫn đường đều mang màu trúc.',
		swatches: [
			{ name: 'Trúc', token: '--bamboo', light: '#5a6851', dark: '#a9b99b', use: 'Liên kết, nhãn chuyên mục, viền focus, thanh tiến độ', contrast: '5.31 / 8.58' },
			{ name: 'Trúc già', token: '--bamboo-dark', light: '#3f4a38', dark: '#cbd6bf', use: 'Liên kết khi rê chuột', contrast: '8.35 / 11.82' },
			{ name: 'Lá non', token: '--leaf', light: '#a9b99b', use: 'Lá cành trúc trên nền --ink', contrast: '7.91 trên --ink' },
			{ name: 'Lá già', token: '--leaf-deep', light: '#7d8c6f', use: 'Mặt dưới lá, trên nền --ink', contrast: '4.58 trên --ink' },
		],
	},
	{
		title: 'Điểm nhấn',
		note: 'Dùng rất ít. Vàng chỉ để trang trí, đỏ son chỉ cho con dấu và vài dấu hiệu nhỏ.',
		swatches: [
			{ name: 'Vàng cũ', token: '--gold', light: '#c7b99f', dark: '#8a7e66', use: 'Vạch trái 3px, số thứ tự, dấu chấm ngăn cách', contrast: '1.73 / 4.47, không dùng cho chữ' },
			{ name: 'Vàng sáng', token: '--gold-light', light: '#c7b99f', use: 'Liên kết chân trang, nút đăng ký, vùng chọn chữ', contrast: '8.51 trên --ink' },
			{ name: 'Son ấn', token: '--seal', light: '#8c302b', dark: '#d98a80', use: 'Con dấu, nhãn "Bài nổi bật", dấu sáp', contrast: '7.30 / 6.71' },
		],
	},
];

// Rough share of a screen, for the proportion bar.
const share = [
	{ label: 'Giấy', color: '#f5f2ea', size: 62 },
	{ label: 'Mực', color: '#242720', size: 24 },
	{ label: 'Trúc', color: '#5a6851', size: 9 },
	{ label: 'Vàng', color: '#c7b99f', size: 4 },
	{ label: 'Son', color: '#8c302b', size: 1 },
];

const fonts = [
	{
		name: 'Newsreader',
		token: '--font-heading',
		role: 'Tiêu đề, wordmark, sapo, trích dẫn',
		weights: 'Chỉ 400. Nghiêng là nghiêng giả lập, không tải tệp italic.',
		why: 'Serif dành cho đọc màn hình, nét thanh mảnh, có chất tạp chí văn chương. Dấu tiếng Việt rõ ở cỡ lớn.',
		className: 'f-heading',
	},
	{
		name: 'Be Vietnam Pro',
		token: '--font-body',
		role: 'Thân bài, giao diện, metadata, nhãn',
		weights: '400 cho chữ thường, 600 cho chữ đậm, nhãn và nút.',
		why: 'Sans thiết kế cho tiếng Việt: dấu đặt đúng chỗ, không chồng lên dòng trên. Gọn và dễ đọc trên điện thoại.',
		className: 'f-body',
	},
	{
		name: 'Patrick Hand',
		token: '--font-hand',
		role: 'Chỉ trong lá thư cảm ơn của nút thả tim',
		weights: 'Chỉ 400, tải khi lá thư mở lần đầu.',
		why: 'Nét viết tay cho một khoảnh khắc riêng tư. Không dùng ở bất kỳ chỗ nào khác.',
		className: 'f-hand',
	},
];

const scale = [
	{ role: 'Tên site (trang chủ)', spec: 'Newsreader 38-76px, cao dòng 1.1', className: 's-display', sample: SITE_NAME },
	{ role: 'Tiêu đề bài (h1)', spec: 'Newsreader 32-44px, cao dòng 1.25', className: 's-h1', sample: 'Rễ sâu để vững, thân thẳng để bền' },
	{ role: 'Tiêu đề mục (h2)', spec: 'Newsreader 24-28px', className: 's-h2', sample: 'Người xưa đọc sách thế nào' },
	{ role: 'Sapo', spec: 'Newsreader nghiêng 19-22px, --text-2', className: 's-standfirst', sample: 'Ghi chép về một thói quen nhỏ đã đổi cách tôi làm việc.' },
	{ role: 'Thân bài', spec: 'Be Vietnam Pro 17-18px, cao dòng 1.8', className: 's-body', sample: 'Viết để bồi dưỡng nội lực, không để chứng minh mình đã giỏi. Mỗi bài là một lần tự hỏi lại điều mình tưởng đã biết.' },
	{ role: 'Nhãn (.kicker)', spec: 'Be Vietnam Pro 600, 12px, in hoa, giãn 0.08em, --bamboo', className: 'kicker', sample: 'Tàng Thư Quán Thế' },
	{ role: 'Metadata (.meta)', spec: 'Be Vietnam Pro 13px, --text-2', className: 'meta', sample: '14 tháng 11, 2026 · 8 phút đọc' },
];

const files = [
	{ file: 'logo.svg', use: 'Bản gốc con dấu, 128 × 128' },
	{ file: 'favicon.svg', use: 'Favicon vector, cùng hình con dấu' },
	{ file: 'logo.png', use: '512px, ảnh Open Graph mặc định' },
	{ file: 'apple-touch-icon.png', use: '180px, biểu tượng màn hình chính iOS' },
	{ file: 'favicon.ico', use: '16, 32, 48px cho trình duyệt cũ' },
	{ file: 'sprig.svg', use: 'Cành trúc đơn, dùng làm mask cho con dấu CSS và hiệu ứng liên kết' },
];

const leaves = [
	[11.2, 49.6, -6, 1],
	[13.4, 47.1, -102, 0.95],
	[26.9, 32.2, -10, 0.86],
	[29.7, 29.1, -96, 0.78],
	[41.4, 16.1, -14, 0.66],
	[43.7, 13.6, -88, 0.6],
	[56, 0, -48, 0.5],
];
const leafPath = 'M0 0C9-5.5 24-6.5 36 0 24 3.6 9 3.6 0 0Z';
---

<BaseLayout
	title="Nhận diện thương hiệu"
	description="Tài liệu nội bộ: logo, màu sắc và kiểu chữ của Trúc Chí Lập Thân."
	wide
	noindex
>
	<header class="intro">
		<p class="kicker">Tài liệu nội bộ · Không lập chỉ mục</p>
		<h1>Nhận diện thương hiệu</h1>
		<p class="standfirst">
			Thư phòng của một nhà nho trong hình hài tạp chí số. Trang này ghi lại logo, màu sắc và kiểu chữ của {AUTHOR}, để
			mọi thứ mới làm ra vẫn cùng một giọng.
		</p>
		<nav class="toc" aria-label="Các phần">
			<a href="#logo">01 Logo</a>
			<a href="#mau-sac">02 Màu sắc</a>
			<a href="#kieu-chu">03 Kiểu chữ</a>
		</nav>
	</header>

	<!-- 01 Logo -->
	<section id="logo" class="part" aria-labelledby="logo-title">
		<div class="part-head">
			<span class="num">01</span>
			<h2 id="logo-title">Logo</h2>
		</div>

		<div class="split">
			<div class="hero-mark">
				<img src="/logo.svg" width="256" height="256" alt="Con dấu Tư Mã Đại Nhân: cành trúc bảy lá trên nền son" />
			</div>
			<div class="text">
				<h3>Con dấu cành trúc</h3>
				<p>
					Logo là một con dấu vuông màu son, trong đó một cành trúc bảy lá được khắc chừa ra màu giấy. Nó gợi chiếc triện
					nhà nho đóng dưới bài viết: người viết ký tên bằng chí hướng của mình.
				</p>
				<p>
					Trúc là cái "chí" trong <em>{SITE_NAME}</em>: thẳng thân, rỗng ruột, có đốt. Thẳng là ngay thẳng, rỗng là
					khiêm tốn, đốt là tiết tháo. Cành mọc chéo lên phải, lá nhỏ dần về ngọn, như một người đang lớn lên từng
					bậc: <em>{SITE_TAGLINE}</em>
				</p>
				<p class="motto">{SITE_MOTTO}</p>
				<div class="downloads">
					<a class="button" href="/logo.png" download="tu-ma-dai-nhan-logo.png">Tải PNG <span>512px</span></a>
					<a class="button ghost" href="/logo.svg" download="tu-ma-dai-nhan-logo.svg">Tải SVG <span>vector</span></a>
				</div>
			</div>
		</div>

		<h3>Cấu trúc</h3>
		<div class="split">
			<figure class="construction">
				<svg viewBox="-20 -14 168 156" role="img" aria-label="Lưới dựng logo: lề, khung cành và trục thân">
					<defs><path id="leaf" d={leafPath} /></defs>
					<rect width="128" height="128" fill="#8c302b" />
					<g fill="#f5f2ea" transform="translate(20 14.7) scale(1.1733) translate(6 15)">
						{leaves.map(([x, y, a, s]) => <use href="#leaf" transform={`translate(${x} ${y}) rotate(${a}) scale(${s})`} />)}
						<path d="M-5 67.5 56 0" fill="none" stroke="#f5f2ea" stroke-width="3.5" stroke-linecap="round" />
					</g>
					<g class="guide">
						<rect x="20" y="14.7" width="88" height="98.6" />
						<path d="M12 120.3 102 21.4" />
						<path d="M0 -6h20M108 -6h20M-6 0v14.7" />
					</g>
					<g class="guide-label">
						<text x="10" y="-8">20</text>
						<text x="118" y="-8">20</text>
						<text x="-8" y="10" text-anchor="end">15</text>
					</g>
				</svg>
				<figcaption class="meta">Lưới 128 đơn vị. Đường đứt: khung của cành và trục thân.</figcaption>
			</figure>
			<div class="text">
				<dl class="specs">
					<dt>Khung</dt>
					<dd>Hình vuông 128 × 128, góc vuông, không bo.</dd>
					<dt>Cành</dt>
					<dd>Rộng 88 (69%), cao 99 (77%). Lề trái phải 20, trên dưới 15. Cành lệch nhẹ để ngọn có chỗ thở.</dd>
					<dt>Thân</dt>
					<dd>Một nét thẳng nghiêng khoảng 48°, đầu tròn, dày 3.5 đơn vị gốc.</dd>
					<dt>Lá</dt>
					<dd>
						Một hình lá duy nhất, lặp bảy lần: ba cặp lá mọc đôi (một lá xuôi, một lá đứng), nhỏ dần từ 100% xuống 60%,
						và một lá ngọn 50% chạy theo hướng thân.
					</dd>
					<dt>Khoảng trống</dt>
					<dd>Quanh con dấu chừa ít nhất 1/4 cạnh của nó. Trong header là 0.75rem cho dấu 2rem.</dd>
					<dt>Cỡ nhỏ nhất</dt>
					<dd>16px (favicon). Trên trang, con dấu không nhỏ hơn 2rem (32px).</dd>
				</dl>
			</div>
		</div>

		<h3>Các dạng dùng</h3>
		<ul class="variants">
			<li>
				<div class="tile paper"><span class="seal-css" style="--s: 4rem"></span></div>
				<p><strong>Con dấu</strong> Dạng chính. Son trên giấy, ở header, tiểu sử tác giả, favicon.</p>
			</li>
			<li>
				<div class="tile paper">
					<span class="lockup">
						<span class="seal-css" style="--s: 2rem"></span>
						<span class="wordmark">
							<span class="name">{AUTHOR}</span>
							<span class="site">{SITE_NAME}</span>
						</span>
					</span>
				</div>
				<p><strong>Dấu và chữ</strong> Header: dấu 2rem cách wordmark 0.75rem. Bút danh trên, tên site dưới.</p>
			</li>
			<li>
				<div class="tile ink"><span class="seal-css" style="--s: 4rem"></span></div>
				<p><strong>Trên nền tối</strong> Giữ nguyên son và giấy, không đảo màu.</p>
			</li>
			<li>
				<div class="tile paper"><span class="sprig" style="--c: #5a6851"></span></div>
				<p><strong>Cành trúc</strong> Không khung, màu trúc. Hiện ở hiệu ứng rê chuột liên kết và ô ảnh chờ (màu vàng).</p>
			</li>
			<li>
				<div class="tile ink">
					<svg class="leafy" viewBox="-6 -15 75 84" aria-hidden="true">
						{leaves.map(([x, y, a, s]) => (
							<g transform={`translate(${x} ${y}) rotate(${a}) scale(${s})`}>
								<path fill="#a9b99b" d="M0 0C9-5.5 24-6.5 36 0 24 1 10 1 0 0Z" />
								<path fill="#7d8c6f" d="M0 0C10 1 24 1 36 0 24 3.6 9 3.6 0 0Z" />
							</g>
						))}
						<path d="M-5 67.5 56 0" fill="none" stroke="#c7b99f" stroke-width="2" stroke-linecap="round" />
					</svg>
				</div>
				<p><strong>Lá hai màu</strong> Chỉ trên --ink: lá non và lá già, như cành mọc ở đầu dải đăng ký.</p>
			</li>
			<li>
				<div class="tile paper"><span class="wordmark solo"><span class="name">{AUTHOR}</span></span></div>
				<p><strong>Chữ</strong> Newsreader in hoa, giãn 0.1em. Khi không có chỗ cho dấu.</p>
			</li>
		</ul>

		<h3>Không nên</h3>
		<ul class="donts">
			<li>
				<div class="tile paper"><span class="seal-css" style="--s: 3.5rem; rotate: 20deg"></span></div>
				<p>Xoay hoặc lật con dấu.</p>
			</li>
			<li>
				<div class="tile paper"><span class="seal-css" style="--s: 3.5rem; background: #2f6fb3"></span></div>
				<p>Đổi màu ngoài bảng màu.</p>
			</li>
			<li>
				<div class="tile paper"><span class="seal-css" style="--s: 3.5rem; border-radius: 0.75rem; box-shadow: 0 0.5rem 1rem #0005"></span></div>
				<p>Bo góc, đổ bóng, gradient.</p>
			</li>
			<li>
				<div class="tile paper"><span class="seal-css" style="--s: 3.5rem; width: 5.5rem"></span></div>
				<p>Kéo giãn sai tỉ lệ.</p>
			</li>
			<li>
				<div class="tile" style="background: #a5443b"><span class="seal-css" style="--s: 3.5rem"></span></div>
				<p>Đặt dấu son trên nền đỏ hoặc ảnh rối.</p>
			</li>
		</ul>

		<h3>Tệp nguồn</h3>
		<table class="files">
			<thead><tr><th scope="col">Tệp</th><th scope="col">Dùng cho</th></tr></thead>
			<tbody>
				{files.map(({ file, use }) => (
					<tr>
						<td><a href={`/${file}`} download><code>/{file}</code></a></td>
						<td>{use}</td>
					</tr>
				))}
			</tbody>
		</table>
		<p class="meta files-note">
			Sửa <code>logo.svg</code> và <code>favicon.svg</code>, rồi xuất lại PNG và ICO bằng <code>rsvg-convert</code> và
			<code>magick</code>. Con dấu trên trang là CSS: <code>--seal</code> phủ mask <code>sprig.svg</code> kiểu
			<code>exclude</code>.
		</p>
	</section>

	<!-- 02 Colors -->
	<section id="mau-sac" class="part" aria-labelledby="color-title">
		<div class="part-head">
			<span class="num">02</span>
			<h2 id="color-title">Màu sắc</h2>
		</div>
		<p class="lede">
			Giấy ấm, mực ngả lục, trúc cho liên kết, son cho vài dấu nhỏ. Thứ bậc đến từ chữ, khoảng trắng và đường kẻ mảnh, không
			từ màu. Mỗi ô dưới đây chia đôi: trái là chế độ sáng, phải là chế độ tối.
		</p>

		<figure class="share">
			<div class="share-bar">
				{share.map(({ label, color, size }) => (
					<span style={`background: ${color}; flex-grow: ${size}`} title={`${label} ${size}%`}></span>
				))}
			</div>
			<figcaption class="share-legend meta">
				{share.map(({ label, color, size }) => (
					<span><i style={`background: ${color}`}></i>{label} ~{size}%</span>
				))}
			</figcaption>
		</figure>

		{palette.map(({ title, note, swatches }) => (
			<div class="group">
				<div class="group-head">
					<h3>{title}</h3>
					<p>{note}</p>
				</div>
				<ul class="swatches">
					{swatches.map(({ name, token, light, dark, use, contrast }) => (
						<li>
							<div class="chip">
								<span style={`background: ${light}`}></span>
								{dark && <span style={`background: ${dark}`}></span>}
							</div>
							<p class="sw-name">{name}</p>
							<p class="sw-token"><code>{token}</code></p>
							<p class="sw-hex">{dark ? `${light} · ${dark}` : `${light} · cả hai chế độ`}</p>
							<p class="sw-use">{use}</p>
							<p class="sw-contrast">Tương phản: {contrast}</p>
						</li>
					))}
				</ul>
			</div>
		))}

		<h3>Quy tắc</h3>
		<ul class="rules">
			<li>Chữ luôn đạt WCAG AA (4.5:1) trên nền. Vì thế <code>--text-2</code> và <code>--bamboo</code> đậm hơn màu trong brief gốc.</li>
			<li><code>--gold</code> và <code>--border</code> không bao giờ là màu chữ.</li>
			<li>Đỏ son chỉ xuất hiện vài chỗ trên một màn hình. Không dùng cho nút, nền lớn hay cảnh báo.</li>
			<li>Không bóng đổ, không gradient, không thẻ có khung. Dùng một bậc giấy (<code>--wash</code>) để tách lớp.</li>
			<li>Trong code luôn dùng token (<code>var(--text-2)</code>), không dùng mã hex. Token tự chuyển sáng tối bằng <code>light-dark()</code>.</li>
			<li>Đổi bảng màu thì cập nhật cả <code>theme-color</code> trong <code>BaseHead.astro</code> và các tệp logo.</li>
		</ul>
	</section>

	<!-- 03 Type -->
	<section id="kieu-chu" class="part" aria-labelledby="type-title">
		<div class="part-head">
			<span class="num">03</span>
