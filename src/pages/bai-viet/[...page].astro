---
import type { GetStaticPaths, Page } from 'astro';
import { PAGE_SIZE } from '../../consts';
import ListLayout from '../../layouts/ListLayout.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPublishedPosts();
	return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

type Props = { page: Page<Post> };

const { page } = Astro.props;
---

<ListLayout
	title="Tất cả bài viết"
	description="Mọi ghi chép của hai chuyên mục, mới nhất trước."
	metaDescription="Tất cả bài viết của Trúc Chí Lập Thân: Tàng Thư Quán Thế về sách, sử, triết học và tu thân; Binh Pháp Công Sở về lãnh đạo và quản trị."
	{page}
/>
