---
import type { GetStaticPaths, Page } from 'astro';
import { PAGE_SIZE } from '../../consts';
import ListLayout from '../../layouts/ListLayout.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPublishedPosts();
	return paginate(posts, { pageSize: PAGE_SIZE, props: { newest: posts[0]?.data.pubDate } });
}) satisfies GetStaticPaths;

type Props = { page: Page<Post>; newest?: Date };

const { page, newest } = Astro.props;
---

<ListLayout
	title="Tất cả bài viết"
	description="Mọi ghi chép trên hành trình học, mới nhất trước."
	metaDescription="Tất cả bài viết về lãnh đạo và quản trị doanh nghiệp, từ quan sát, câu hỏi, nghiên cứu đến bài học, cho chủ doanh nghiệp SME và quản lý trẻ."
	{newest}
	{page}
/>
