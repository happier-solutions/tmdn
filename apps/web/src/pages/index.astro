---
import { getEntry } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import PostLead from '../components/PostLead.astro';
import PostRow from '../components/PostRow.astro';
import { AUTHOR, AUTHOR_BIO, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../consts';
import { PILLARS, topicsOf } from '../data/taxonomy';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, topicOf } from '../lib/posts';

const LATEST = 6;
const FEATURED = 4;

const posts = await getPublishedPosts();
const latest = posts.slice(0, LATEST);
const featured = posts.filter((post) => post.data.featured).slice(0, FEATURED);
const [featuredLead, ...featuredRest] = featured;
const countIn = (pillar: string) => posts.filter((post) => topicOf(post).pillar === pillar).length;

// The "Lời tự răn" lives on the about page, edited in the CMS; the home page shows the same lines.
// Plain lines only: emphasis marks and <br /> are stripped, an *italic* first line becomes the subtitle.
const about = await getEntry('pages', 'gioi-thieu');
const creedLines = (about?.body?.split(/^##\s+Lời tự răn.*$/m)[1] ?? '')
	.split(/\n/)
	.map((line) => line.replace(/<br\s*\/?>/g, '').trim())
	.filter(Boolean);
const creedSubtitle = /^\*[^*]+\*$/.test(creedLines[0] ?? '') ? creedLines.shift()!.slice(1, -1) : undefined;
const creed = creedLines.map((line) => line.replace(/[*_]/g, ''));

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_NAME,
	alternateName: AUTHOR,
	description: SITE_DESCRIPTION,
	inLanguage: 'vi',
	url: Astro.site?.href,
};
---

<BaseLayout description={SITE_DESCRIPTION} wide {jsonLd}>
	<section class="statement" aria-labelledby="site-name">
		<p class="dateline">
			<time id="today" hidden></time>
			{/* Static pages can't know today's date, so the visitor's clock sets it before first paint. */}
			<script is:inline>
				(() => {
					const now = new Date();
					const el = document.getElementById('today');
					const pad = (n) => String(n).padStart(2, '0');
					el.dateTime = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
					const weekday = new Intl.DateTimeFormat('vi-VN', { weekday: 'long' }).format(now);
					el.textContent = `${weekday}, ${now.getDate()} tháng ${now.getMonth() + 1}, ${now.getFullYear()}`;
					el.hidden = false;
				})();
			</script>
			<span>Ghi chép · Nghiên cứu · Chiêm nghiệm</span>
		</p>
		<p class="kicker">Giới thiệu</p>
		<div class="statement-body">
			<div class="titles">
				<h1 id="site-name">{SITE_NAME}</h1>
				<h2 class="tagline">{SITE_TAGLINE}</h2>
			</div>
			<div class="about">
				<p>
					Không gian ghi chép, nghiên cứu và chia sẻ những suy ngẫm về con người, tri thức, tư duy, lịch
					sử, xã hội, lãnh đạo và quản trị doanh nghiệp. Để bồi dưỡng nội lực, mở rộng nhận thức và phát
					triển năng lực lập nghiệp.
				</p>
				<a href="/gioi-thieu/"><span class="link-line">Tìm hiểu thêm</span></a>
			</div>
		</div>
	</section>

	<section class="block" aria-labelledby="pillars-heading">
		<h2 id="pillars-heading" class="section-title">Hai chuyên mục</h2>
		<div class="pillars">
			{PILLARS.map((pillar, index) => {
				const count = countIn(pillar.slug);
				return (
					<article class="pillar">
						<p class="kicker">Chuyên mục {String(index + 1).padStart(2, '0')}</p>
						<h3><a href={`/${pillar.slug}/`}>{pillar.label}</a></h3>
						<p class="pillar-motto">{pillar.description}</p>
						<p class="meta">{topicsOf(pillar.slug).length} chủ đề · {count ? `${count} bài viết` : 'sắp có bài'}</p>
					</article>
				);
			})}
		</div>
	</section>

	{latest.length > 0 && (
		<section class="block" aria-labelledby="latest-heading">
			<div class="block-head">
				<h2 id="latest-heading" class="section-title">Bài viết mới</h2>
				<a href="/bai-viet/"><span class="link-line">Tất cả bài viết</span></a>
			</div>
			<ul class="cards">
				{latest.map((post) => <li><PostCard {post} /></li>)}
			</ul>
		</section>
	)}

	{featuredLead && (
		<section class="block" aria-labelledby="featured-heading">
			<div class="block-head">
				<h2 id="featured-heading" class="section-title">Bài viết nổi bật</h2>
				<a href="/bai-noi-bat/"><span class="link-line">Tất cả bài nổi bật</span></a>
			</div>
			<PostLead post={featuredLead} level={3} />
			{featuredRest.length > 0 && (
				<ul class="rows">
					{featuredRest.map((post) => <li><PostRow {post} level={3} /></li>)}
				</ul>
			)}
		</section>
	)}

	<section class="block author" aria-labelledby="author-heading">
		<span class="seal" aria-hidden="true"></span>
		<div class="author-text">
			<p class="kicker">Lời người viết</p>
			<h2 id="author-heading">{AUTHOR}</h2>
			<p>{AUTHOR_BIO}</p>
			{creed.length > 0 ? (
				<details class="creed">
					<summary><span class="link-line">Đọc lời tự răn</span></summary>
					<div class="creed-body">
						{creedSubtitle && <p class="creed-subtitle">{creedSubtitle}</p>}
						<p class="verses">{creed.map((line) => <span>{line}</span>)}</p>
					</div>
				</details>
			) : (
				<a href="/gioi-thieu/" rel="author"><span class="link-line">Đọc lời tự răn</span></a>
			)}
		</div>
		<blockquote class="maxim">
			<p>Cứ bền bỉ mà học, điềm đạm mà làm.<br />Rễ sâu thì trúc tự vươn cao.</p>
		</blockquote>
	</section>
</BaseLayout>
<style>
	.dateline {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		justify-content: space-between;
		margin: 0 0 2rem;
		padding-block: 0.5rem;
		border-block: 1px solid var(--border);
		color: var(--text-2);
		font-size: 0.8125rem;
		line-height: 1.5;
	}
	.dateline time:first-letter {
		text-transform: uppercase;
	}
	.statement > .kicker {
		margin-bottom: 1rem;
	}
	.statement-body {
		display: grid;
		gap: 1.5rem;
	}
	.titles {
		display: grid;
		gap: 0.75rem;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.375rem, 1.5rem + 4vw, 4.75rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.tagline {
		margin: 0;
		color: var(--text-2);
		font-size: clamp(1.25rem, 1.0625rem + 0.75vw, 1.625rem);
		line-height: 1.4;
	}
	.about p {
		margin: 0 0 0.75rem;
		color: var(--text-2);
		font-size: 1rem;
		line-height: 1.75;
		text-wrap: pretty;
	}
	/* Title left, the description right, both resting on the same baseline. */
	@media (min-width: 56rem) {
		.statement-body {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			gap: 4rem;
			align-items: end;
		}
		.about {
			padding-left: 2rem;
			border-left: 1px solid var(--border);
		}
	}

	/* Every block opens on a full-strength rule, like a magazine's section break. */
	.block {
		margin-top: 3rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--text);
	}
	.section-title {
		margin: 0 0 1.5rem;
		font-size: 1.75rem;
	}
	.block-head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}
	.block-head .section-title {
		margin: 0;
	}
	.block-head a {
		font-size: 0.9375rem;
	}

	/* Two matched columns split by a hairline, so neither pillar outranks the other. */
	.pillars {
		display: grid;
	}
	.pillar {
		display: grid;
		gap: 0.5rem;
		align-content: start;
		padding-block: 1.5rem;
		border-top: 1px solid var(--border);
	}
	.pillar:first-child {
		padding-top: 0;
		border-top: 0;
	}
	.pillar h3 {
		margin: 0;
		font-size: clamp(1.625rem, 1.375rem + 1vw, 2.125rem);
		line-height: 1.2;
	}
	.pillar h3 a {
		color: inherit;
	}
	.pillar-motto {
		max-width: 32rem;
		margin: 0;
		font-family: var(--font-heading);
		font-size: 1.125rem;
		font-style: italic;
		line-height: 1.5;
		text-wrap: pretty;
	}
	.pillar .meta {
		margin: 0.25rem 0 0;
	}
	@media (min-width: 48rem) {
		.pillars {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.pillar,
		.pillar:first-child {
			padding: 0 0 0.5rem;
			border-top: 0;
		}
		.pillar:first-child {
			padding-right: 2.5rem;
		}
		.pillar + .pillar {
			padding-left: 2.5rem;
			border-left: 1px solid var(--border);
		}
	}

	.cards {
		display: grid;
		gap: 2.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 40rem) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 64rem) {
		.cards {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.rows {
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.rows li {
		padding-block: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.author {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}
	.seal {
		width: 4rem;
		height: 4rem;
		background: var(--seal);
		mask:
			url('/sprig.svg') center / 2.75rem no-repeat exclude,
			linear-gradient(#000 0 0);
	}
	.author-text h2 {
		margin: 0.25rem 0 0.75rem;
		font-size: 1.75rem;
	}
	.author-text p:not(.kicker) {
		max-width: 36rem;
		color: var(--text-2);
		font-size: 1rem;
		line-height: 1.75;
	}
	/* Opens in place, like a link that unfolds the text under it. */
	.creed summary {
		--line: 0;
		--leaf: 0;
		--leaf-delay: 0ms;
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--bamboo);
		cursor: pointer;
		list-style: none;
	}
	.creed summary::-webkit-details-marker {
		display: none;
	}
	.creed summary::after {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		margin-top: -0.25rem;
		border: solid currentColor;
		border-width: 0 1.5px 1.5px 0;
		rotate: 45deg;
		/* Steps aside on hover so the link's sprig has room to grow. */
		translate: calc(var(--leaf) * 1em) 0;
		@media (prefers-reduced-motion: no-preference) {
			transition: translate 200ms ease-out;
		}
	}
	.creed[open] summary::after {
		margin-top: 0.25rem;
		rotate: 225deg;
	}
	@media (hover: hover) {
		.creed summary:hover {
			--line: 1;
			--leaf: 1;
			--leaf-delay: 180ms;
			color: var(--bamboo-dark);
		}
	}
	.creed summary:focus-visible {
		outline: 2px solid var(--bamboo);
		outline-offset: 2px;
	}
	.creed-body {
		margin-top: 1.25rem;
		padding-left: 1.25rem;
		border-left: 3px solid var(--gold);
	}
	.author-text .creed-body p {
		margin: 0;
		color: var(--text);
		font-family: var(--font-heading);
		font-size: 1.125rem;
		line-height: 1.75;
	}
	/* One verse per line; a wrapped verse hangs, so each still reads as one. */
	.verses span {
		display: block;
		padding-left: 1em;
		text-indent: -1em;
	}
	.author-text .creed-body .verses {
		display: grid;
		gap: 0.375rem;
		line-height: 1.5;
	}
	.author-text .creed-body .creed-subtitle {
		margin-bottom: 0.5rem;
		color: var(--text-2);
		font-style: italic;
	}
	.maxim {
		grid-column: 1 / -1;
		margin: 0;
		padding: 1.25rem 0 0;
		border: 0;
		border-top: 1px solid var(--border);
		color: var(--text-2);
		font-family: var(--font-heading);
		font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
		font-style: italic;
		line-height: 1.5;
	}
	.maxim p {
		margin: 0;
	}
	@media (min-width: 56rem) {
		.author {
			grid-template-columns: 4rem minmax(0, 6fr) minmax(0, 5fr);
			gap: 2rem;
		}
		.maxim {
			grid-column: 3;
			align-self: start;
			margin-top: 2rem;
			padding: 0 0 0 2rem;
			border-top: 0;
			border-left: 1px solid var(--border);
		}
	}
</style>
