    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "astro": "^7.4.5",
    "better-auth": "^1.7.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "wrangler": "4.164.0"
  }
}
