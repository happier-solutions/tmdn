{
  "name": "peos",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "wrangler types && astro check",
    "preview": "astro preview",
    "astro": "astro",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply peos --local",
